            posthog.init(@((MarkupString)PostHogProjectTokenJson), {
                api_host: @((MarkupString)PostHogHostUrlJson),
                defaults: '2026-01-30',
                person_profiles: 'identified_only',
            });
        </script>
    }
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["theme.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
</body>

</html>

@code {
    private const string ThemeCookieName = "rocketreps_theme";

    [CascadingParameter]
    private Microsoft.AspNetCore.Http.HttpContext? HttpContext { get; set; }

    private string InitialThemeMode => NormalizeThemeMode(HttpContext?.Request.Cookies[ThemeCookieName]);

    private string? InitialTheme => InitialThemeMode is "light" or "dark" ? InitialThemeMode : null;

    private string? PostHogProjectToken => Configuration["PostHog:ProjectToken"];

    private string PostHogHostUrl => Configuration["PostHog:HostUrl"] ?? "https://us.i.posthog.com";

    private bool ShouldRenderPostHog => !string.IsNullOrWhiteSpace(PostHogProjectToken) &&
        (HostEnvironment.IsProduction() || HostEnvironment.IsEnvironment("Staging"));

    private string PostHogProjectTokenJson => System.Text.Json.JsonSerializer.Serialize(PostHogProjectToken);

    private string PostHogHostUrlJson => System.Text.Json.JsonSerializer.Serialize(PostHogHostUrl);

    private static string NormalizeThemeMode(string? value) => value is "light" or "dark" or "system" ? value : "system";
}
