@implements IDisposable

@inject NavigationManager NavigationManager

<header class="site-header">
    <a class="brand" href="" aria-label="Rocket Reps home">
        <span class="brand-mark" aria-hidden="true">RR</span>
        <span>
            <strong>Rocket Reps</strong>
            <small>Spaced repetition for young learners</small>
        </span>
    </a>

    <input type="checkbox" title="Navigation menu" class="nav-toggle" />

    <nav class="primary-nav" onclick="document.querySelector('.nav-toggle')?.click()">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Mission Control</NavLink>
        <NavLink class="nav-link" href="decks">Stock Decks</NavLink>
        <NavLink class="nav-link" href="auth">Study Hub</NavLink>

        <AuthorizeView>
            <Authorized>
                <NavLink class="nav-link" href="Account/Manage">@context.User.Identity?.Name</NavLink>
                <form action="Account/Logout" method="post" class="logout-form">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <button type="submit" class="nav-link nav-button">Log out</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <NavLink class="nav-link" href="Account/Login">Log in</NavLink>
                <NavLink class="nav-link nav-cta" href="Account/Register">Start a Mission</NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</header>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
