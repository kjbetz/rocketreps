@page "/auth"

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

<PageTitle>Study Hub</PageTitle>

<section class="page-hero compact">
    <p class="eyebrow">Study Hub</p>
    <h1>Your launch dashboard is next.</h1>
    <p>This protected page is a placeholder for assigned decks, due reviews, and student progress once the first study flow is wired up.</p>
</section>

<AuthorizeView>
    <div class="content-card">
        Welcome aboard, @context.User.Identity?.Name. The next mission is classroom joins and assigned deck practice.
    </div>
</AuthorizeView>
