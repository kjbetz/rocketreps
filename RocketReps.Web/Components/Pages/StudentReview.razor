@page "/student/review/{AssignmentId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Student")]
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using RocketReps.Web.Data
@using RocketReps.Web.ReviewScheduling
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject FsrsReviewScheduler ReviewScheduler
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>Review Mission</PageTitle>

@if (isLoading)
{
    <div class="loading-card">Loading review mission...</div>
}
else if (loadError is not null)
{
    <section class="page-hero compact">
        <p class="eyebrow">Mission unavailable</p>
        <h1>@loadError</h1>
        <p><a href="student">Back to student mission board</a></p>
    </section>
}
else if (assignment is not null)
{
    <section class="page-hero compact">
        <p class="eyebrow">@assignment.ClassroomName</p>
        <h1>@assignment.DeckTitle</h1>
        <p>Answer the card, then Rocket Reps will schedule the next review from right or wrong.</p>
    </section>

    @if (showBreakPrompt)
    {
        <section class="content-card review-complete">
            <p class="eyebrow">Mission checkpoint</p>
            <h2>Great launch. You reviewed @completedCount cards.</h2>
            <p class="status-muted">Want to keep going or take a break?</p>
            <button type="button" class="button-primary" @onclick="ContinueReviewAsync">Keep going</button>
            <a class="button-secondary" href="student">Back to missions</a>
        </section>
    }
    else if (currentCard is null)
    {
        <section class="content-card review-complete">
            <h2>All done for now.</h2>
            <p class="status-muted">You reviewed @completedCount cards. Check back later for your next review.</p>
            <a class="button-primary" href="student">Back to missions</a>
        </section>
    }
    else
    {
        <section class="review-shell">
            <div class="review-progress">
                Reviewed @completedCount this session · @(currentCard.IsDue ? "Review card" : "New card")
            </div>
            <article class="review-card">
                @if (currentCard.CardType == CardType.AudioPrompt)
                {
                    <p class="eyebrow">Listen</p>
                    <div class="audio-prompt-card" aria-live="polite">
                        <button type="button" class="audio-prompt-button" disabled="@isSpeaking" @onclick="SpeakCurrentWordAsync">
                            @(isSpeaking ? "Playing..." : "Hear word")
                        </button>
                        <p class="status-muted">Tap the button, then spell the word you hear.</p>
                        @if (audioPromptError is not null)
                        {
                            <p class="status-danger">@audioPromptError</p>
                        }
                        <div class="audio-settings">
                            <button type="button"
                                    class="audio-settings-toggle"
                                    aria-controls="SpeechVoicePanel"
                                    aria-expanded="@(isVoiceSettingsOpen ? "true" : "false")"
                                    @onclick="ToggleVoiceSettingsAsync">
                                <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
                                    <path d="M12 15.5A3.5 3.5 0 1 0 12 8a3.5 3.5 0 0 0 0 7.5Zm8.4-3.5c0-.5-.1-1-.2-1.5l2-1.5-2-3.4-2.4 1a8.4 8.4 0 0 0-2.5-1.5L15 2.5h-4l-.4 2.6c-.9.3-1.7.8-2.5 1.5l-2.4-1-2 3.4 2 1.5c-.1.5-.2 1-.2 1.5s.1 1 .2 1.5l-2 1.5 2 3.4 2.4-1c.8.7 1.6 1.2 2.5 1.5l.4 2.6h4l.4-2.6c.9-.3 1.7-.8 2.5-1.5l2.4 1 2-3.4-2-1.5c.1-.5.2-1 .2-1.5Z" />
                                </svg>
                                <span>Voice</span>
                                <small>@SelectedVoiceSummary</small>
                            </button>
                            @if (isVoiceSettingsOpen)
                            {
                                <div id="SpeechVoicePanel" class="audio-settings-panel">
                                    @if (isLoadingVoices)
                                    {
                                        <p class="status-muted">Loading voices...</p>
                                    }
                                    else
                                    {
                                        <label for="SpeechVoice">Spoken voice</label>
                                        <select id="SpeechVoice" class="field-input audio-voice-select" value="@selectedVoiceUri" @onchange="SelectVoiceAsync">
                                            <option value="">Browser default</option>
                                            @foreach (var voice in speechVoices)
                                            {
                                                <option value="@voice.VoiceUri">@VoiceLabel(voice)</option>
                                            }
                                        </select>
                                        @if (hasLoadedVoiceOptions && speechVoices.Count == 0)
                                        {
                                            <p class="status-muted">No extra voices are available yet. The browser default will still work.</p>
                                        }
                                        <button type="button" class="button-secondary audio-settings-retry" @onclick="RefreshVoiceOptionsAsync">
                                            Reload voices
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <p class="eyebrow">Question</p>
                    <h2>@currentCard.Front</h2>
                }

                @if (feedback is null)
                {
                    <EditForm Model="answerInput" OnValidSubmit="SubmitAnswerAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="status-danger" />
                        <div class="field-stack">
                            <input @ref="answerElement"
                                   @bind="answerInput.Answer"
                                   @bind:event="oninput"
                                   id="StudentAnswer"
                                   class="field-input review-answer"
                                   autocomplete="off"
                                   autocapitalize="off"
                                   autocorrect="off"
                                   enterkeyhint="done"
                                   inputmode="@AnswerInputMode"
                                   pattern="@AnswerPattern"
                                   spellcheck="false"
                                   autofocus />
                            <label for="StudentAnswer">Your answer</label>
                        </div>
                        <button type="submit" class="button-primary button-full" disabled="@isSubmitting">
                            @(isSubmitting ? "Checking..." : "Check answer")
                        </button>
                    </EditForm>
                }
                else
                {
                    <div class="notice @(feedback.WasCorrect ? "notice-success" : "notice-warning")">
                        <strong>@(feedback.WasCorrect ? "Correct!" : "Not yet.")</strong>
                        <span>The answer is @feedback.CorrectAnswer.</span>
                        @if (feedback.WasCorrect)
                        {
                            <span>@CorrectReviewMessage(feedback.CorrectReviewCount)</span>
                        }
                    </div>
                    <button type="button" class="button-primary button-full" disabled="@isMovingNext" @onclick="MoveNextAsync">
                        @(isMovingNext ? "Loading..." : "Next card")
                    </button>
                }
            </article>
        </section>
    }
}

@code {
    [Parameter]
    public Guid AssignmentId { get; set; }

    private const int BreakPromptCardCount = 20;
    private readonly AnswerInput answerInput = new();
    private ApplicationUser? currentStudent;
    private AssignmentHeader? assignment;
    private ReviewCard? currentCard;
    private AnswerFeedback? feedback;
    private bool isLoading = true;
    private bool isSubmitting;
    private bool isMovingNext;
    private bool isSpeaking;
    private bool isLoadingVoices;
    private bool hasLoadedVoiceOptions;
    private bool isVoiceSettingsOpen;
    private bool showBreakPrompt;
    private bool shouldFocusAnswer;
    private string? loadError;
    private string? audioPromptError;
    private string selectedVoiceUri = string.Empty;
    private List<SpeechVoiceOption> speechVoices = [];
    private int completedCount;
    private ElementReference answerElement;
    private IJSObjectReference? speechModule;

    private string AnswerInputMode => currentCard is { CardType: CardType.MathFact }
        ? "numeric"
        : IsDecimalAnswer(currentCard?.CorrectAnswer ?? currentCard?.Back) ? "decimal" : "text";

    private string? AnswerPattern => AnswerInputMode == "numeric" ? "[0-9]*" : null;

    private string SelectedVoiceSummary => isLoadingVoices
        ? "Loading..."
        : string.IsNullOrWhiteSpace(selectedVoiceUri)
        ? "Browser default"
        : speechVoices.FirstOrDefault(voice => voice.VoiceUri == selectedVoiceUri)?.Name ?? "Browser default";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentStudent = await UserManager.GetUserAsync(authState.User);

        if (currentStudent is null)
        {
            loadError = "We could not load your student account.";
            isLoading = false;
            return;
        }

        assignment = await DbContext.DeckAssignments
            .Where(deckAssignment => deckAssignment.Id == AssignmentId &&
                deckAssignment.IsActive &&
                deckAssignment.Classroom != null &&
                deckAssignment.Classroom.Memberships.Any(membership => membership.UserId == currentStudent.Id &&
                    membership.Role == ClassroomMemberRole.Student &&
                    membership.Status == ClassroomMemberStatus.Approved))
            .Select(deckAssignment => new AssignmentHeader(
                deckAssignment.Id,
                deckAssignment.Classroom!.Name,
                deckAssignment.Deck!.Title,
                deckAssignment.DeckId))
            .SingleOrDefaultAsync();

        if (assignment is null)
        {
            loadError = "This deck is not active for your classroom.";
            isLoading = false;
            return;
        }

        currentCard = await LoadNextCardAsync();
        isLoading = false;
        shouldFocusAnswer = currentCard is not null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldFocusAnswer && currentCard is not null && feedback is null)
        {
            shouldFocusAnswer = false;
            await answerElement.FocusAsync(preventScroll: true);
        }

        if (currentCard?.CardType == CardType.AudioPrompt && !hasLoadedVoiceOptions && !isLoadingVoices)
        {
            await LoadSpeechVoicesAsync();
            StateHasChanged();
        }
    }

    private async Task SubmitAnswerAsync()
    {
        if (isSubmitting || currentStudent is null || currentCard is null || assignment is null)
        {
            return;
        }

        isSubmitting = true;
        try
        {
            var correctAnswer = currentCard.CorrectAnswer ?? currentCard.Back;
            var wasCorrect = NormalizeAnswer(answerInput.Answer) == NormalizeAnswer(correctAnswer);
            var rating = wasCorrect ? ReviewRating.Good : ReviewRating.Again;
            var now = DateTimeOffset.UtcNow;

            var progress = await DbContext.StudentCardProgress
                .SingleOrDefaultAsync(existingProgress => existingProgress.UserId == currentStudent.Id && existingProgress.CardId == currentCard.Id);

            if (progress is null)
            {
                progress = new StudentCardProgress
                {
                    Id = Guid.NewGuid(),
                    UserId = currentStudent.Id,
                    CardId = currentCard.Id,
                    DueAt = now,
                };
                DbContext.StudentCardProgress.Add(progress);
            }

            var schedule = ReviewScheduler.Review(progress, rating, now);

            progress.DueAt = schedule.NextDueAt;
            progress.ReviewCount++;
            progress.LapseCount += wasCorrect ? 0 : 1;
            progress.Stability = schedule.Stability;
            progress.Difficulty = schedule.Difficulty;
            progress.FsrsState = schedule.FsrsState;
            progress.FsrsStep = schedule.FsrsStep;
            progress.LastRating = rating;
            progress.LastReviewedAt = now;

            DbContext.ReviewLogs.Add(new ReviewLog
            {
                Id = Guid.NewGuid(),
                UserId = currentStudent.Id,
                CardId = currentCard.Id,
                DeckAssignmentId = assignment.AssignmentId,
                ReviewedAt = now,
                WasCorrect = wasCorrect,
                Rating = rating,
                ScheduledInterval = schedule.ScheduledInterval,
                NextDueAt = schedule.NextDueAt,
            });

            await DbContext.SaveChangesAsync();
            completedCount++;
            var correctReviewCount = wasCorrect ? Math.Max(0, progress.ReviewCount - progress.LapseCount) : 0;
            feedback = new AnswerFeedback(wasCorrect, correctAnswer, correctReviewCount);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task MoveNextAsync()
    {
        if (isMovingNext)
        {
            return;
        }

        isMovingNext = true;
        answerInput.Answer = string.Empty;
        feedback = null;
        audioPromptError = null;

        if (completedCount > 0 && completedCount % BreakPromptCardCount == 0 && await HasEligibleCardAsync())
        {
            showBreakPrompt = true;
            currentCard = null;
            isMovingNext = false;
            return;
        }

        currentCard = await LoadNextCardAsync();
        isMovingNext = false;
        shouldFocusAnswer = currentCard is not null;
    }

    private async Task SpeakCurrentWordAsync()
    {
        if (isSpeaking || currentCard is null)
        {
            return;
        }

        isSpeaking = true;
        audioPromptError = null;
        try
        {
            speechModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/studentReviewSpeech.js");
            var word = currentCard.CorrectAnswer ?? currentCard.Back;
            var didSpeak = await speechModule.InvokeAsync<bool>("speak", word, "en-US", selectedVoiceUri);
            if (!didSpeak)
            {
                audioPromptError = "This browser cannot play the word aloud. Ask your teacher for help.";
            }
            else if (speechVoices.Count == 0)
            {
                await LoadSpeechVoicesAsync(forceReload: true);
            }
        }
        catch (JSException)
        {
            audioPromptError = "Rocket Reps could not play the word aloud. Try again or ask your teacher for help.";
        }
        finally
        {
            isSpeaking = false;
        }
    }

    private async Task LoadSpeechVoicesAsync(bool forceReload = false)
    {
        if ((!forceReload && hasLoadedVoiceOptions) || isLoadingVoices)
        {
            return;
        }

        isLoadingVoices = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            speechModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/studentReviewSpeech.js");
            speechVoices = await speechModule.InvokeAsync<List<SpeechVoiceOption>>("getVoices");
            var savedVoiceUri = await speechModule.InvokeAsync<string>("getSavedVoiceUri");
            selectedVoiceUri = speechVoices.Any(voice => voice.VoiceUri == savedVoiceUri) ? savedVoiceUri : string.Empty;
        }
        catch (JSException)
        {
            speechVoices = [];
            selectedVoiceUri = string.Empty;
        }
        finally
        {
            hasLoadedVoiceOptions = true;
            isLoadingVoices = false;
        }
    }

    private async Task SelectVoiceAsync(ChangeEventArgs eventArgs)
    {
        selectedVoiceUri = eventArgs.Value?.ToString() ?? string.Empty;
        try
        {
            speechModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/studentReviewSpeech.js");
            await speechModule.InvokeVoidAsync("saveVoiceUri", selectedVoiceUri);
        }
        catch (JSException)
        {
        }
    }

    private async Task RefreshVoiceOptionsAsync()
    {
        await LoadSpeechVoicesAsync(forceReload: true);
    }

    private async Task ToggleVoiceSettingsAsync()
    {
        isVoiceSettingsOpen = !isVoiceSettingsOpen;
        if (isVoiceSettingsOpen && (!hasLoadedVoiceOptions || speechVoices.Count == 0))
        {
            await LoadSpeechVoicesAsync(forceReload: hasLoadedVoiceOptions);
        }
    }

    private async Task ContinueReviewAsync()
    {
        showBreakPrompt = false;
        currentCard = await LoadNextCardAsync();
        shouldFocusAnswer = currentCard is not null;
    }

    private async Task<ReviewCard?> LoadNextCardAsync()
    {
        if (currentStudent is null || assignment is null)
        {
            return null;
        }

        var now = DateTimeOffset.UtcNow;
        var dueCard = await DbContext.StudentCardProgress
            .Where(progress => progress.UserId == currentStudent.Id &&
                progress.DueAt <= now &&
                progress.Card != null &&
                progress.Card.DeckId == assignment.DeckId)
            .OrderBy(progress => progress.DueAt)
            .ThenBy(progress => progress.Card!.SortOrder)
            .Select(progress => new ReviewCard(
                progress.CardId,
                progress.Card!.Front,
                progress.Card.Back,
                progress.Card.CorrectAnswer,
                progress.Card.CardType,
                true))
            .FirstOrDefaultAsync();

        if (dueCard is not null)
        {
            return dueCard;
        }

        var newCards = DbContext.Cards
            .Where(card => card.DeckId == assignment.DeckId &&
                !DbContext.StudentCardProgress.Any(progress =>
                    progress.UserId == currentStudent.Id && progress.CardId == card.Id))
            .OrderBy(card => card.Id);
        var newCardCount = await newCards.CountAsync();

        if (newCardCount == 0)
        {
            return null;
        }

        var randomIndex = Random.Shared.Next(newCardCount);
        return await newCards
            .Skip(randomIndex)
            .Select(card => new ReviewCard(card.Id, card.Front, card.Back, card.CorrectAnswer, card.CardType, false))
            .FirstAsync();
    }

    private async Task<bool> HasEligibleCardAsync()
    {
        if (currentStudent is null || assignment is null)
        {
            return false;
        }

        var now = DateTimeOffset.UtcNow;
        var hasDueCard = await DbContext.StudentCardProgress
            .AnyAsync(progress => progress.UserId == currentStudent.Id &&
                progress.DueAt <= now &&
                progress.Card != null &&
                progress.Card.DeckId == assignment.DeckId);

        if (hasDueCard)
        {
            return true;
        }

        return await DbContext.Cards
            .AnyAsync(card => card.DeckId == assignment.DeckId &&
                !DbContext.StudentCardProgress.Any(progress =>
                    progress.UserId == currentStudent.Id && progress.CardId == card.Id));
    }

    private static string NormalizeAnswer(string value) => value.Trim().ToUpperInvariant();

    private static bool IsDecimalAnswer(string? answer) =>
        decimal.TryParse(answer, NumberStyles.Number, CultureInfo.InvariantCulture, out _);

    private static string CorrectReviewMessage(int correctReviewCount) => correctReviewCount == 1
        ? "You've answered this one correctly 1 time."
        : $"You've answered this one correctly {correctReviewCount} times.";

    private static string VoiceLabel(SpeechVoiceOption voice)
    {
        var serviceLabel = voice.LocalService ? "local" : "cloud";
        var defaultLabel = voice.IsDefault ? ", default" : string.Empty;
        return $"{voice.Name} ({voice.Lang}, {serviceLabel}{defaultLabel})";
    }

    private sealed class AnswerInput
    {
        [Required]
        public string Answer { get; set; } = string.Empty;
    }

    private sealed class SpeechVoiceOption
    {
        public string VoiceUri { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Lang { get; set; } = string.Empty;
        public bool IsDefault { get; set; }
        public bool LocalService { get; set; }
    }

    private sealed record AssignmentHeader(Guid AssignmentId, string ClassroomName, string DeckTitle, Guid DeckId);
    private sealed record ReviewCard(Guid Id, string Front, string Back, string? CorrectAnswer, CardType CardType, bool IsDue);
    private sealed record AnswerFeedback(bool WasCorrect, string CorrectAnswer, int CorrectReviewCount);

    public async ValueTask DisposeAsync()
    {
        if (speechModule is not null)
        {
            try
            {
                await speechModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
