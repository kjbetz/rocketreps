@page "/early-access"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.WebUtilities
@using RocketReps.Web.Data

@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager

<PageTitle>Early Access - Rocket Reps</PageTitle>

<section class="page-hero compact early-access-hero">
    <p class="eyebrow">Early access</p>
    <h1>Bring Rocket Reps to your classroom.</h1>
    <p>Tell us where Rocket Reps could help, and we will follow up after the Open House.</p>
</section>

<div class="layout-grid early-access-grid">
    <div class="layout-panel">
        <section>
            @if (submitted)
            {
                <div class="notice notice-success early-access-success" role="status">
                    <h2>You are on the list.</h2>
                    <p>Thanks for your interest in Rocket Reps. We will follow up soon with next steps.</p>
                    <a class="button-primary" href="demo">Launch Demo</a>
                </div>
            }
            else
            {
                <EditForm Model="Input" method="post" OnValidSubmit="SubmitAsync" FormName="early-access">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="status-danger" role="alert" />

                    <div class="field-stack">
                        <InputText @bind-Value="Input.Name" id="Input.Name" class="field-input" autocomplete="name" placeholder="Your name" />
                        <label for="Input.Name">Name</label>
                        <ValidationMessage For="() => Input.Name" class="status-danger" />
                    </div>

                    <div class="field-stack">
                        <InputText @bind-Value="Input.Email" id="Input.Email" class="field-input" autocomplete="email" placeholder="you@example.com" />
                        <label for="Input.Email">Email</label>
                        <ValidationMessage For="() => Input.Email" class="status-danger" />
                    </div>

                    <div class="field-stack">
                        <InputSelect @bind-Value="Input.Role" id="Input.Role" class="field-input">
                            <option value="">Choose one</option>
                            <option value="Teacher">Teacher</option>
                            <option value="Parent">Parent</option>
                            <option value="School leader">School leader</option>
                            <option value="Other">Other</option>
                        </InputSelect>
                        <label for="Input.Role">I am a</label>
                        <ValidationMessage For="() => Input.Role" class="status-danger" />
                    </div>

                    <div class="field-stack">
                        <InputText @bind-Value="Input.SchoolOrOrganization" id="Input.SchoolOrOrganization" class="field-input" placeholder="Riverview STEM Academy" />
                        <label for="Input.SchoolOrOrganization">School or organization <span class="status-muted">optional</span></label>
                        <ValidationMessage For="() => Input.SchoolOrOrganization" class="status-danger" />
                    </div>

                    <div class="field-stack">
                        <InputSelect @bind-Value="Input.PlanInterest" id="Input.PlanInterest" class="field-input">
                            <option value="">Not sure yet</option>
                            <option value="Free">Free</option>
                            <option value="Pro">Pro</option>
                            <option value="Pro + AI">Pro + AI</option>
                            <option value="School or district">School or district</option>
                        </InputSelect>
                        <label for="Input.PlanInterest">Plan interest <span class="status-muted">optional</span></label>
                        <ValidationMessage For="() => Input.PlanInterest" class="status-danger" />
                    </div>

                    <div class="field-stack">
                        <InputTextArea @bind-Value="Input.Message" id="Input.Message" class="field-input early-access-message" placeholder="What would you like Rocket Reps to help with?" />
                        <label for="Input.Message">Message <span class="status-muted">optional</span></label>
                        <ValidationMessage For="() => Input.Message" class="status-danger" />
                    </div>

                    <button type="submit" class="button-primary button-full">Request early access</button>
                </EditForm>
            }
        </section>
    </div>

    <div class="layout-sidebar">
        <section>
            <p class="eyebrow">Open House demo</p>
            <h2>No account needed today.</h2>
            <p class="status-muted">Use the live demo to explore teacher and student workflows. Early access just helps us know who to follow up with after the event.</p>
            <a class="button-secondary button-full" href="demo">Launch Demo</a>
        </section>
    </div>
</div>

@code {
    private bool submitted;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
        ApplyPlanFromQueryString();
    }

    private void ApplyPlanFromQueryString()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("plan", out var plan))
        {
            Input.PlanInterest = NormalizePlan(plan.ToString());
        }
    }

    private static string NormalizePlan(string plan) => plan.Trim() switch
    {
        "Free" => "Free",
        "Pro" => "Pro",
        "Pro + AI" => "Pro + AI",
        "Pro+" => "Pro + AI",
        "Pro Plus" => "Pro + AI",
        "Pro AI" => "Pro + AI",
        "School or district" => "School or district",
        "School" => "School or district",
        _ => "",
    };

    private async Task SubmitAsync()
    {
        DbContext.EarlyAccessSignups.Add(new EarlyAccessSignup
        {
            Id = Guid.NewGuid(),
            Name = Input.Name.Trim(),
            Email = Input.Email.Trim(),
            Role = Input.Role.Trim(),
            SchoolOrOrganization = string.IsNullOrWhiteSpace(Input.SchoolOrOrganization) ? null : Input.SchoolOrOrganization.Trim(),
            PlanInterest = string.IsNullOrWhiteSpace(Input.PlanInterest) ? null : Input.PlanInterest.Trim(),
            Message = string.IsNullOrWhiteSpace(Input.Message) ? null : Input.Message.Trim(),
            Source = "Open House",
        });

        await DbContext.SaveChangesAsync();
        submitted = true;
        Input = new();
    }

    private sealed class InputModel
    {
        [Required]
        [StringLength(160, MinimumLength = 2)]
        public string Name { get; set; } = "";

        [Required]
        [EmailAddress]
        [StringLength(320)]
        public string Email { get; set; } = "";

        [Required]
        [StringLength(80)]
        public string Role { get; set; } = "";

        [StringLength(200)]
        public string? SchoolOrOrganization { get; set; }

        [StringLength(80)]
        public string? PlanInterest { get; set; }

        [StringLength(1_000)]
        public string? Message { get; set; }
    }
}
