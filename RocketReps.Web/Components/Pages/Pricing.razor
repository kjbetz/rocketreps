@page "/pricing"

<PageTitle>Pricing - Rocket Reps</PageTitle>

<section class="page-hero compact pricing-hero">
    <p class="eyebrow">Teacher pricing</p>
    <h1>Simple plans for classroom reps.</h1>
    <p>Start free with one classroom, then upgrade when Rocket Reps becomes part of your regular teaching routine.</p>
</section>

<section class="pricing-grid" aria-label="Rocket Reps pricing plans">
    <article class="pricing-card">
        <div class="pricing-card-header">
            <p class="pricing-plan-name">Free</p>
            <p class="pricing-price">$0</p>
            <p class="pricing-tagline">Great for trying Rocket Reps with one classroom.</p>
        </div>
        <ul class="pricing-feature-list">
            <li>1 classroom</li>
            <li>Unlimited students</li>
            <li>Unlimited review usage</li>
            <li>Unlimited stock decks</li>
            <li>3 custom decks</li>
            <li>Basic classroom progress tracking</li>
            <li>Access to public/community decks</li>
        </ul>
        <a class="button-secondary button-full" href="Account/Register">Get started free</a>
    </article>

    <article class="pricing-card pricing-card-recommended" aria-label="Pro plan, recommended">
        <div class="recommended-badge">Recommended</div>
        <div class="pricing-card-header">
            <p class="pricing-plan-name">Pro</p>
            <p class="pricing-price">$29<span>/year</span></p>
            <p class="pricing-tagline">For teachers using Rocket Reps across multiple classes.</p>
        </div>
        <ul class="pricing-feature-list">
            <li>Unlimited classrooms</li>
            <li>Unlimited students</li>
            <li>Unlimited review usage</li>
            <li>Unlimited stock decks</li>
            <li>Unlimited custom decks</li>
            <li>Access to public/community decks</li>
            <li>Create private or public decks</li>
            <li>Classroom analytics</li>
        </ul>
        <a class="button-primary button-full" href="Account/Register">Upgrade to Pro</a>
    </article>

    <article class="pricing-card">
        <div class="pricing-card-header">
            <p class="pricing-plan-name">Pro+</p>
            <p class="pricing-price">$49<span>/year</span></p>
            <p class="pricing-tagline">Adds AI assistance for faster deck creation.</p>
        </div>
        <ul class="pricing-feature-list">
            <li>Everything in Pro</li>
            <li>AI-assisted deck creation</li>
            <li>AI question suggestions</li>
            <li>AI answer/explanation help</li>
            <li>Generate decks from pasted notes or topics</li>
            <li>Future AI-powered differentiation support</li>
        </ul>
        <a class="button-secondary button-full" href="Account/Register">Upgrade to Pro+</a>
    </article>
</section>

<section class="schools-pricing-card">
    <div>
        <p class="eyebrow">Schools &amp; districts</p>
        <h2>Need Rocket Reps for a whole school or district?</h2>
        <p>Contact us for multi-teacher, school, and district options.</p>
    </div>
    <a class="button-primary" href="mailto:hello@rocketreps.com?subject=Rocket%20Reps%20school%20pricing">Contact us</a>
</section>
