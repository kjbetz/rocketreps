@page "/teacher/classrooms/{ClassroomId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Teacher")]
@using System.ComponentModel.DataAnnotations
@using System.Security.Cryptography
@using System.Text
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RocketReps.Web.Data
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>@(classroom?.Name ?? "Classroom")</PageTitle>

@if (isLoading)
{
    <div class="loading-card">Loading classroom...</div>
}
else if (classroom is null)
{
    <section class="page-hero compact">
        <p class="eyebrow">Classroom</p>
        <h1>Classroom not found.</h1>
        <p>This classroom may not exist, or you may not have access to manage it.</p>
        <a class="button-primary" href="teacher">Back to classrooms</a>
    </section>
}
else
{
    <section class="page-hero compact classroom-hero">
        <a class="button-secondary" href="teacher">Back to classrooms</a>
        <p class="eyebrow">Classroom workspace</p>
        <h1>@classroom.Name</h1>
        <p>Manage this classroom's students and deck assignments. Turn deck practice on or off here when this group is ready.</p>
        <div class="classroom-stat-row hero-stat-row">
            <span>Join code @classroom.JoinCode</span>
            <span>@classroom.StudentCount students</span>
            <span>@classroom.ActiveDeckCount active decks</span>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="notice @statusClass">@statusMessage</div>
    }

    @if (createdCredential is not null)
    {
        <section class="content-card credential-card" aria-live="polite">
            <p class="eyebrow">Student login created</p>
            <h2>@createdCredential.DisplayName</h2>
            <div class="credential-grid">
                <div>
                    <span>Username</span>
                    <strong>@createdCredential.UserName</strong>
                </div>
                <div>
                    <span>Password</span>
                    <strong>@createdCredential.Password</strong>
                </div>
            </div>
            <p class="status-muted">Passwords are shown once. Reset the student password later if this one is lost.</p>
        </section>
    }

    <div class="layout-grid dashboard-grid">
        <section class="layout-panel">
            <div class="content-card">
                <h2>Create a student login</h2>
                <p class="status-muted">Students use teacher-created usernames, not email addresses.</p>
                <EditForm Model="studentInput" OnValidSubmit="CreateStudentAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="status-danger" />
                    <div class="field-stack">
                        <InputText @bind-Value="studentInput.DisplayName" id="StudentDisplayName" class="field-input" placeholder="Aria M." />
                        <label for="StudentDisplayName">Student display name</label>
                    </div>
                    <button type="submit" class="button-primary button-full">Generate login</button>
                </EditForm>
            </div>
        </section>

        <section class="layout-panel">
            <div class="content-card">
                <h2>Assign a deck</h2>
                <p class="status-muted">Choose a ready-made or custom deck for this classroom.</p>
                <EditForm Model="assignmentInput" OnValidSubmit="AssignDeckAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="status-danger" />
                    <div class="assignment-form-grid">
                        <div class="field-stack">
                            <InputSelect @bind-Value="assignmentInput.DeckId" id="AssignmentDeck" class="field-input">
                                <option value="">Choose a deck</option>
                                @foreach (var deck in decks)
                                {
                                    <option value="@deck.Id">@deck.Title (@deck.CardCount cards)</option>
                                }
                            </InputSelect>
                            <label for="AssignmentDeck">Deck</label>
                        </div>
                        <label class="field-label assignment-active-toggle">
                            <InputCheckbox @bind-Value="assignmentInput.IsActive" class="field-checkbox" />
                            Active now
                        </label>
                    </div>
                    <button type="submit" class="button-primary button-full" disabled="@(decks.Count == 0)">Assign deck</button>
                </EditForm>
            </div>
        </section>
    </div>

    <section class="dashboard-section">
        <div class="dashboard-section-header">
            <div>
                <p class="eyebrow">Deck assignments</p>
                <h2>Practice for this classroom</h2>
            </div>
        </div>
        @if (assignments.Count == 0)
        {
            <div class="content-card">No decks assigned yet. Assign a deck above, then activate it when students should work on it.</div>
        }
        else
        {
            <div class="management-grid">
                @foreach (var assignment in assignments)
                {
                    <article class="management-card">
                        <div class="management-card-header">
                            <h3>@assignment.DeckTitle</h3>
                            <span class="@(assignment.IsActive ? "status-pill active" : "status-pill")">@(assignment.IsActive ? "Active" : "Inactive")</span>
                        </div>
                        <p>@assignment.CardCount cards</p>
                        <button type="button" class="button-secondary" @onclick="() => ToggleAssignmentAsync(assignment.Id)">
                            @(assignment.IsActive ? "Turn off" : "Activate")
                        </button>
                    </article>
                }
            </div>
        }
    </section>

    <section class="dashboard-section">
        <div class="dashboard-section-header">
            <div>
                <p class="eyebrow">Students</p>
                <h2>Roster</h2>
            </div>
        </div>
        @if (students.Count == 0)
        {
            <div class="content-card">Student accounts you create for this classroom will appear here with their usernames.</div>
        }
        else
        {
            <div class="table-wrap content-card">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Username</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in students)
                        {
                            <tr>
                                <td>@student.DisplayName</td>
                                <td>@student.UserName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    [Parameter]
    public Guid ClassroomId { get; set; }

    private readonly StudentInput studentInput = new();
    private readonly AssignmentInput assignmentInput = new() { IsActive = true };
    private readonly string[] passwordWords = ["comet", "orbit", "lunar", "solar", "nova", "rocket", "star"];
    private ApplicationUser? currentTeacher;
    private bool isLoading = true;
    private string? statusMessage;
    private string statusClass = "notice-success";
    private CreatedCredential? createdCredential;
    private ClassroomDetails? classroom;
    private List<DeckOption> decks = [];
    private List<AssignmentSummary> assignments = [];
    private List<StudentSummary> students = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentTeacher = await UserManager.GetUserAsync(authState.User);
        await LoadClassroomAsync();
        isLoading = false;
    }

    private async Task CreateStudentAsync()
    {
        if (currentTeacher is null)
        {
            return;
        }

        createdCredential = null;
        var classroomEntity = await GetTeacherClassroomQuery()
            .SingleOrDefaultAsync(classroom => classroom.Id == ClassroomId);

        if (classroomEntity is null)
        {
            SetStatus("Classroom not found.", "notice-danger");
            return;
        }

        var displayName = studentInput.DisplayName.Trim();
        var userName = await GenerateStudentUserNameAsync(classroomEntity.JoinCode, displayName);
        var password = GenerateStudentPassword();
        var student = new ApplicationUser
        {
            UserName = userName,
            DisplayName = displayName,
            EmailConfirmed = true,
            SchoolId = classroomEntity.SchoolId,
        };

        var result = await UserManager.CreateAsync(student, password);
        if (!result.Succeeded)
        {
            SetStatus(string.Join(" ", result.Errors.Select(error => error.Description)), "notice-danger");
            return;
        }

        result = await UserManager.AddToRoleAsync(student, "Student");
        if (!result.Succeeded)
        {
            SetStatus(string.Join(" ", result.Errors.Select(error => error.Description)), "notice-danger");
            return;
        }

        DbContext.ClassroomMemberships.Add(new ClassroomMembership
        {
            Id = Guid.NewGuid(),
            ClassroomId = classroomEntity.Id,
            UserId = student.Id,
            Role = ClassroomMemberRole.Student,
            Status = ClassroomMemberStatus.Approved,
            ApprovedAt = DateTimeOffset.UtcNow,
            ApprovedByTeacherId = currentTeacher.Id,
        });

        await DbContext.SaveChangesAsync();
        studentInput.DisplayName = string.Empty;
        createdCredential = new CreatedCredential(displayName, userName, password);
        SetStatus($"Created login for {displayName}.");
        await LoadClassroomAsync();
    }

    private async Task AssignDeckAsync()
    {
        if (currentTeacher is null || assignmentInput.DeckId is null)
        {
            return;
        }

        createdCredential = null;
        var classroomEntity = await GetTeacherClassroomQuery()
            .SingleOrDefaultAsync(classroom => classroom.Id == ClassroomId);

        if (classroomEntity is null)
        {
            SetStatus("Classroom not found.", "notice-danger");
            return;
        }

        var deckExists = await DbContext.Decks.AnyAsync(deck =>
            deck.Id == assignmentInput.DeckId.Value &&
            deck.IsPublished &&
            (deck.IsGlobalStock || deck.OwnerTeacherId == currentTeacher.Id));
        if (!deckExists)
        {
            SetStatus("Choose a published deck before assigning it.", "notice-danger");
            return;
        }

        var assignment = await DbContext.DeckAssignments
            .FirstOrDefaultAsync(existingAssignment => existingAssignment.ClassroomId == classroomEntity.Id && existingAssignment.DeckId == assignmentInput.DeckId.Value);

        if (assignment is null)
        {
            assignment = new DeckAssignment
            {
                Id = Guid.NewGuid(),
                ClassroomId = classroomEntity.Id,
                DeckId = assignmentInput.DeckId.Value,
                AssignedByTeacherId = currentTeacher.Id,
                IsActive = assignmentInput.IsActive,
                IsOpenStudyAllowed = true,
            };

            DbContext.DeckAssignments.Add(assignment);
        }
        else
        {
            assignment.IsActive = assignmentInput.IsActive;
        }

        await DbContext.SaveChangesAsync();
        SetStatus(assignmentInput.IsActive ? "Deck assigned and activated." : "Deck assigned as inactive.");
        assignmentInput.DeckId = null;
        assignmentInput.IsActive = true;
        await LoadClassroomAsync();
    }

    private async Task ToggleAssignmentAsync(Guid assignmentId)
    {
        if (currentTeacher is null)
        {
            return;
        }

        createdCredential = null;
        var assignment = await DbContext.DeckAssignments
            .Include(assignment => assignment.Classroom)
            .SingleOrDefaultAsync(assignment => assignment.Id == assignmentId &&
                assignment.ClassroomId == ClassroomId &&
                assignment.Classroom != null &&
                (assignment.Classroom.CreatedByTeacherId == currentTeacher.Id ||
                    assignment.Classroom.Memberships.Any(membership => membership.UserId == currentTeacher.Id &&
                        membership.Role == ClassroomMemberRole.Teacher &&
                        membership.Status == ClassroomMemberStatus.Approved)));

        if (assignment is null)
        {
            SetStatus("Assignment not found for this classroom.", "notice-danger");
            return;
        }

        assignment.IsActive = !assignment.IsActive;
        await DbContext.SaveChangesAsync();
        SetStatus(assignment.IsActive ? "Deck activated." : "Deck turned off.");
        await LoadClassroomAsync();
    }

    private async Task LoadClassroomAsync()
    {
        if (currentTeacher is null)
        {
            return;
        }

        classroom = await GetTeacherClassroomQuery()
            .Where(classroom => classroom.Id == ClassroomId)
            .Select(classroom => new ClassroomDetails(
                classroom.Id,
                classroom.Name,
                classroom.JoinCode,
                classroom.Memberships.Count(membership => membership.Role == ClassroomMemberRole.Student && membership.Status == ClassroomMemberStatus.Approved),
                classroom.Assignments.Count(assignment => assignment.IsActive)))
            .SingleOrDefaultAsync();

        if (classroom is null)
        {
            decks = [];
            assignments = [];
            students = [];
            return;
        }

        decks = await DbContext.Decks
            .Where(deck => deck.IsPublished && (deck.IsGlobalStock || deck.OwnerTeacherId == currentTeacher.Id))
            .OrderBy(deck => deck.Title)
            .Select(deck => new DeckOption(deck.Id, deck.Title, deck.Cards.Count))
            .ToListAsync();

        assignments = await DbContext.DeckAssignments
            .Where(assignment => assignment.ClassroomId == ClassroomId)
            .OrderBy(assignment => assignment.Deck!.Title)
            .Select(assignment => new AssignmentSummary(
                assignment.Id,
                assignment.Deck!.Title,
                assignment.Deck.Cards.Count,
                assignment.IsActive))
            .ToListAsync();

        students = await DbContext.ClassroomMemberships
            .Where(membership => membership.ClassroomId == ClassroomId &&
                membership.Role == ClassroomMemberRole.Student &&
                membership.Status == ClassroomMemberStatus.Approved)
            .OrderBy(membership => membership.User!.DisplayName)
            .Select(membership => new StudentSummary(
                membership.User!.DisplayName ?? membership.User.UserName ?? "Student",
                membership.User.UserName ?? ""))
            .ToListAsync();
    }

    private IQueryable<Classroom> GetTeacherClassroomQuery()
    {
        return DbContext.Classrooms
            .Where(classroom => currentTeacher != null &&
                (classroom.CreatedByTeacherId == currentTeacher.Id ||
                    classroom.Memberships.Any(membership => membership.UserId == currentTeacher.Id &&
                        membership.Role == ClassroomMemberRole.Teacher &&
                        membership.Status == ClassroomMemberStatus.Approved)));
    }

    private async Task<string> GenerateStudentUserNameAsync(string joinCode, string displayName)
    {
        var slug = Slugify($"{joinCode}-{displayName}");
        if (slug.Length > 32)
        {
            slug = slug[..32].Trim('-');
        }

        for (var suffix = 0; suffix < 100; suffix++)
        {
            var candidate = suffix == 0 ? slug : $"{slug}-{suffix}";
            if (await UserManager.FindByNameAsync(candidate) is null)
            {
                return candidate;
            }
        }

        return $"{slug}-{RandomNumberGenerator.GetInt32(1000, 9999)}";
    }

    private string GenerateStudentPassword()
    {
        var word = passwordWords[RandomNumberGenerator.GetInt32(passwordWords.Length)];
        return $"Rocket-{RandomNumberGenerator.GetInt32(10, 99)}-{word}";
    }

    private static string Slugify(string value)
    {
        var builder = new StringBuilder(value.Length);
        var previousWasDash = false;

        foreach (var character in value.ToLowerInvariant())
        {
            if (char.IsLetterOrDigit(character))
            {
                builder.Append(character);
                previousWasDash = false;
            }
            else if (!previousWasDash)
            {
                builder.Append('-');
                previousWasDash = true;
            }
        }

        return builder.ToString().Trim('-');
    }

    private void SetStatus(string message, string cssClass = "notice-success")
    {
        statusMessage = message;
        statusClass = cssClass;
    }

    private sealed class StudentInput
    {
        [Required]
        [StringLength(160, MinimumLength = 2)]
        public string DisplayName { get; set; } = string.Empty;
    }

    private sealed class AssignmentInput
    {
        [Required]
        public Guid? DeckId { get; set; }

        public bool IsActive { get; set; }
    }

    private sealed record ClassroomDetails(Guid Id, string Name, string JoinCode, int StudentCount, int ActiveDeckCount);
    private sealed record DeckOption(Guid Id, string Title, int CardCount);
    private sealed record AssignmentSummary(Guid Id, string DeckTitle, int CardCount, bool IsActive);
    private sealed record StudentSummary(string DisplayName, string UserName);
    private sealed record CreatedCredential(string DisplayName, string UserName, string Password);
}
