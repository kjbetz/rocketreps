    private sealed record DeckOption(Guid Id, string Title, int CardCount);
    private sealed record AssignmentSeed(Guid Id, Guid DeckId, string DeckTitle, int CardCount, bool IsActive);
    private sealed record StudentSeed(string UserId, string DisplayName, string UserName);
    private sealed record CardSeed(Guid Id, Guid DeckId, string Front, CardType CardType, int SortOrder);
    private sealed record ProgressSeed(string UserId, Guid CardId, DateTimeOffset DueAt, int ReviewCount, int LapseCount, string FsrsState, DateTimeOffset? LastReviewedAt);
    private sealed record ReviewSeed(string UserId, Guid CardId, Guid DeckAssignmentId, DateTimeOffset ReviewedAt, bool WasCorrect);
    private sealed record ClassroomSnapshot(int PracticedThisWeek, int StudentsNeedingAttention, int DueCardsNow, int? RecentCorrectPercent);
    private sealed record TrickyCard(string Prompt, int MissCount);
    private sealed record AttentionItem(string StudentName, string Signal, string Suggestion, string SeverityClass, int SortOrder);
    private sealed record AssignmentSummary(
        Guid Id,
        Guid DeckId,
        string DeckTitle,
        int CardCount,
        bool IsActive,
        int StartedStudentCount,
        int CaughtUpStudentCount,
        int DueCardCount,
        int NotStartedStudentCount,
        int RecentAttempts,
        int RecentCorrectCount,
        IReadOnlyList<TrickyCard> TrickyCards);
    private sealed record StudentSummary(
        string UserId,
        string DisplayName,
        string UserName,
        int ActiveDeckCount,
        int ActiveDecksStarted,
        int DueCardCount,
        int NewCardCount,
        int LearningCardCount,
        int ReviewCardCount,
        int RecentAttempts,
        int RecentCorrectCount,
        DateTimeOffset? LastReviewedAt,
        IReadOnlyList<TrickyCard> TrickyCards)
    {
        public int? RecentCorrectPercent => RecentAttempts == 0
            ? null
            : (int)Math.Round(RecentCorrectCount * 100.0 / RecentAttempts);

        public string StatusText => ActiveDeckCount == 0
            ? "No active decks"
            : ActiveDecksStarted == 0
                ? "Not started"
                : DueCardCount > 0
                    ? "Needs practice"
                    : NewCardCount > 0
                        ? "Ready for launch"
                        : "Caught up";

        public string StatusClass => StatusText switch
        {
            "Caught up" => "active",
            "Needs practice" => "warning",
            "Not started" => "warning",
            _ => string.Empty,
        };
    }
    private sealed record CreatedCredential(string DisplayName, string UserName, string Password);
