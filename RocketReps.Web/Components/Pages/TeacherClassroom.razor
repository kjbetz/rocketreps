@page "/teacher/classrooms/{ClassroomId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Teacher")]
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Security.Cryptography
@using System.Text
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RocketReps.Web.Data
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IRocketRepsAnalytics Analytics

<PageTitle>@(classroom?.Name ?? "Classroom")</PageTitle>

@if (isLoading)
{
    <div class="loading-card">Loading classroom...</div>
}
else if (classroom is null)
{
    <section class="page-hero compact">
        <p class="eyebrow">Classroom</p>
        <h1>Classroom not found.</h1>
        <p>This classroom may not exist, or you may not have access to manage it.</p>
        <a class="button-primary" href="teacher">Back to classrooms</a>
    </section>
}
else
{
    <section class="page-hero compact classroom-hero">
        <a class="button-secondary" href="teacher">Back to classrooms</a>
        <p class="eyebrow">Classroom workspace</p>
        <h1>@classroom.Name</h1>
        <p>Manage this classroom's students and deck assignments. Turn deck practice on or off here when this group is ready.</p>
        <div class="classroom-stat-row hero-stat-row">
            <span>Join code @classroom.JoinCode</span>
            <span>@classroom.StudentCount students</span>
            <span>@classroom.ActiveDeckCount active decks</span>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="notice @statusClass">@statusMessage</div>
    }

    @if (createdCredential is not null)
    {
        <section class="content-card credential-card" aria-live="polite">
            <p class="eyebrow">Student login created</p>
            <h2>@createdCredential.DisplayName</h2>
            <div class="credential-grid">
                <div>
                    <span>Username</span>
                    <strong>@createdCredential.UserName</strong>
                </div>
                <div>
                    <span>Password</span>
                    <strong>@createdCredential.Password</strong>
                </div>
            </div>
            <p class="status-muted">Passwords are shown once. Reset the student password later if this one is lost.</p>
        </section>
    }

    <section class="dashboard-section">
        <div class="dashboard-section-header">
            <div>
                <p class="eyebrow">Classroom snapshot</p>
                <h2>What needs attention today</h2>
            </div>
        </div>
        <div class="teacher-snapshot-grid" aria-label="Classroom progress summary">
            <div>
                <strong>@snapshot.PracticedThisWeek</strong>
                <span>Practiced this week</span>
            </div>
            <div>
                <strong>@snapshot.StudentsNeedingAttention</strong>
                <span>Need attention</span>
            </div>
            <div>
                <strong>@snapshot.DueCardsNow</strong>
                <span>Due cards now</span>
            </div>
            <div>
                <strong>@PercentText(snapshot.RecentCorrectPercent)</strong>
                <span>Recent correct</span>
            </div>
        </div>

        @if (attentionItems.Count == 0)
        {
            <div class="content-card teacher-empty-state">No urgent student signals yet. Once students practice, this area will show quick follow-ups.</div>
        }
        else
        {
            <div class="teacher-attention-list" aria-label="Students needing attention">
                @foreach (var item in attentionItems)
                {
                    <article class="teacher-attention-card">
                        <span class="status-pill @item.SeverityClass">@item.Signal</span>
                        <h3>@item.StudentName</h3>
                        <p>@item.Suggestion</p>
                    </article>
                }
            </div>
        }
    </section>

    <div class="layout-grid dashboard-grid">
        <section class="layout-panel">
            <div class="content-card">
                <h2>Create a student login</h2>
                <p class="status-muted">Students use teacher-created usernames, not email addresses.</p>
                <EditForm Model="studentInput" OnValidSubmit="CreateStudentAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="status-danger" />
                    <div class="field-stack">
                        <InputText @bind-Value="studentInput.DisplayName" id="StudentDisplayName" class="field-input" placeholder="Aria M." />
                        <label for="StudentDisplayName">Student display name</label>
                    </div>
                    <button type="submit" class="button-primary button-full">Generate login</button>
                </EditForm>
            </div>
        </section>

        <section class="layout-panel">
            <div class="content-card">
                <h2>Assign a deck</h2>
                <p class="status-muted">Choose a ready-made or custom deck for this classroom.</p>
                <EditForm Model="assignmentInput" OnValidSubmit="AssignDeckAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="status-danger" />
                    <div class="assignment-form-grid">
                        <div class="field-stack">
                            <InputSelect @bind-Value="assignmentInput.DeckId" id="AssignmentDeck" class="field-input">
                                <option value="">Choose a deck</option>
                                @foreach (var deck in decks)
                                {
                                    <option value="@deck.Id">@deck.Title (@deck.CardCount cards)</option>
                                }
                            </InputSelect>
                            <label for="AssignmentDeck">Deck</label>
                        </div>
                        <label class="field-label assignment-active-toggle">
                            <InputCheckbox @bind-Value="assignmentInput.IsActive" class="field-checkbox" />
                            Active now
                        </label>
                    </div>
                    <button type="submit" class="button-primary button-full" disabled="@(decks.Count == 0)">Assign deck</button>
                </EditForm>
            </div>
        </section>
    </div>

    <section class="dashboard-section">
        <div class="dashboard-section-header">
            <div>
                <p class="eyebrow">Deck assignments</p>
                <h2>Practice for this classroom</h2>
            </div>
        </div>
        @if (assignments.Count == 0)
        {
            <div class="content-card">No decks assigned yet. Assign a deck above, then activate it when students should work on it.</div>
        }
        else
        {
            <div class="management-grid">
                @foreach (var assignment in assignments)
                {
                    <article class="management-card">
                        <div class="management-card-header">
                            <h3>@assignment.DeckTitle</h3>
                            <span class="@(assignment.IsActive ? "status-pill active" : "status-pill")">@(assignment.IsActive ? "Active" : "Inactive")</span>
                        </div>
                        <p>@assignment.CardCount cards · @assignment.StartedStudentCount started · @assignment.CaughtUpStudentCount caught up</p>
                        <div class="teacher-card-metrics">
                            <span>@assignment.DueCardCount due now</span>
                            <span>@assignment.NotStartedStudentCount not started</span>
                            <span>@AccuracyText(assignment.RecentAttempts, assignment.RecentCorrectCount)</span>
                        </div>
                        @if (assignment.TrickyCards.Count > 0)
                        {
                            <div class="teacher-tricky-list">
                                <strong>Recently tricky</strong>
                                @foreach (var card in assignment.TrickyCards)
                                {
                                    <span>@card.Prompt (@card.MissCount misses)</span>
                                }
                            </div>
                        }
                        <button type="button" class="button-secondary" @onclick="() => ToggleAssignmentAsync(assignment.Id)">
                            @(assignment.IsActive ? "Turn off" : "Activate")
                        </button>
                    </article>
                }
            </div>
        }
    </section>

    <section class="dashboard-section">
        <div class="dashboard-section-header">
            <div>
                <p class="eyebrow">Students</p>
                <h2>Roster</h2>
            </div>
        </div>
        @if (students.Count == 0)
        {
            <div class="content-card">Student accounts you create for this classroom will appear here with their usernames.</div>
        }
        else
        {
            <div class="table-wrap content-card">
                <table class="data-table">
                    <thead>
                            <tr>
                                <th>Student</th>
                                <th>Username</th>
                                <th>Status</th>
                                <th>Due</th>
                                <th>Recent correct</th>
                                <th>Last practice</th>
                                <th>Recently tricky</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in students)
                            {
                                <tr>
                                    <td>@student.DisplayName</td>
                                    <td>@student.UserName</td>
                                    <td><span class="status-pill @student.StatusClass">@student.StatusText</span></td>
                                    <td>@student.DueCardCount</td>
                                    <td>@AccuracyText(student.RecentAttempts, student.RecentCorrectCount)</td>
                                    <td>@LastPracticeText(student.LastReviewedAt)</td>
                                    <td>
                                        @if (student.TrickyCards.Count == 0)
                                        {
                                            <span class="status-muted">None yet</span>
                                        }
                                        else
                                        {
                                            <span>@string.Join(", ", student.TrickyCards.Select(card => card.Prompt))</span>
                                        }
                                    </td>
                                </tr>
                            }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    [Parameter]
    public Guid ClassroomId { get; set; }

    private readonly StudentInput studentInput = new();
    private readonly AssignmentInput assignmentInput = new() { IsActive = true };
    private readonly string[] passwordWords = ["comet", "orbit", "lunar", "solar", "nova", "rocket", "star"];
    private ApplicationUser? currentTeacher;
    private bool isLoading = true;
    private string? statusMessage;
    private string statusClass = "notice-success";
    private CreatedCredential? createdCredential;
    private ClassroomDetails? classroom;
    private List<DeckOption> decks = [];
    private List<AssignmentSummary> assignments = [];
    private List<StudentSummary> students = [];
    private ClassroomSnapshot snapshot = new(0, 0, 0, null);
    private List<AttentionItem> attentionItems = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentTeacher = await UserManager.GetUserAsync(authState.User);
        await LoadClassroomAsync();
        isLoading = false;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            TrackClassroomViewed();
        }
    }

    private async Task CreateStudentAsync()
    {
        if (currentTeacher is null)
        {
            return;
        }

        createdCredential = null;
        var classroomEntity = await GetTeacherClassroomQuery()
            .SingleOrDefaultAsync(classroom => classroom.Id == ClassroomId);

        if (classroomEntity is null)
        {
            SetStatus("Classroom not found.", "notice-danger");
            return;
        }

        var displayName = studentInput.DisplayName.Trim();
        var userName = await GenerateStudentUserNameAsync(classroomEntity.JoinCode, displayName);
        var password = GenerateStudentPassword();
        var student = new ApplicationUser
        {
            UserName = userName,
            DisplayName = displayName,
            EmailConfirmed = true,
            SchoolId = classroomEntity.SchoolId,
        };

        var result = await UserManager.CreateAsync(student, password);
        if (!result.Succeeded)
        {
            SetStatus(string.Join(" ", result.Errors.Select(error => error.Description)), "notice-danger");
            return;
        }

        result = await UserManager.AddToRoleAsync(student, "Student");
        if (!result.Succeeded)
        {
            SetStatus(string.Join(" ", result.Errors.Select(error => error.Description)), "notice-danger");
            return;
        }

        DbContext.ClassroomMemberships.Add(new ClassroomMembership
        {
            Id = Guid.NewGuid(),
            ClassroomId = classroomEntity.Id,
            UserId = student.Id,
            Role = ClassroomMemberRole.Student,
            Status = ClassroomMemberStatus.Approved,
            ApprovedAt = DateTimeOffset.UtcNow,
            ApprovedByTeacherId = currentTeacher.Id,
        });

        await DbContext.SaveChangesAsync();
        Analytics.Capture(currentTeacher.Id, "student_login_created", new()
        {
            ["classroom_id"] = classroomEntity.Id,
            ["student_id"] = student.Id,
            ["school_id"] = classroomEntity.SchoolId,
            ["classroom_student_count"] = students.Count + 1,
        });
        studentInput.DisplayName = string.Empty;
        createdCredential = new CreatedCredential(displayName, userName, password);
        SetStatus($"Created login for {displayName}.");
        await LoadClassroomAsync();
    }

    private async Task AssignDeckAsync()
    {
        if (currentTeacher is null || assignmentInput.DeckId is null)
        {
            return;
        }

        var selectedDeckId = assignmentInput.DeckId.Value;
        var selectedDeck = decks.SingleOrDefault(deck => deck.Id == selectedDeckId);
        createdCredential = null;
        var classroomEntity = await GetTeacherClassroomQuery()
            .SingleOrDefaultAsync(classroom => classroom.Id == ClassroomId);

        if (classroomEntity is null)
        {
            SetStatus("Classroom not found.", "notice-danger");
            return;
        }

        var deckExists = await DbContext.Decks.AnyAsync(deck =>
            deck.Id == selectedDeckId &&
            deck.IsPublished &&
            (deck.IsGlobalStock || deck.OwnerTeacherId == currentTeacher.Id));
        if (!deckExists)
        {
            SetStatus("Choose a published deck before assigning it.", "notice-danger");
            return;
        }

        var assignment = await DbContext.DeckAssignments
            .FirstOrDefaultAsync(existingAssignment => existingAssignment.ClassroomId == classroomEntity.Id && existingAssignment.DeckId == selectedDeckId);

        var wasExistingAssignment = assignment is not null;
        if (assignment is null)
        {
            assignment = new DeckAssignment
            {
                Id = Guid.NewGuid(),
                ClassroomId = classroomEntity.Id,
                DeckId = selectedDeckId,
                AssignedByTeacherId = currentTeacher.Id,
                IsActive = assignmentInput.IsActive,
                IsOpenStudyAllowed = true,
            };

            DbContext.DeckAssignments.Add(assignment);
        }
        else
        {
            assignment.IsActive = assignmentInput.IsActive;
        }

        await DbContext.SaveChangesAsync();
        Analytics.Capture(currentTeacher.Id, "deck_assigned_to_classroom", new()
        {
            ["classroom_id"] = classroomEntity.Id,
            ["deck_id"] = selectedDeckId,
            ["deck_card_count"] = selectedDeck?.CardCount,
            ["assignment_id"] = assignment.Id,
            ["is_active"] = assignment.IsActive,
            ["was_existing_assignment"] = wasExistingAssignment,
        });
        SetStatus(assignmentInput.IsActive ? "Deck assigned and activated." : "Deck assigned as inactive.");
        assignmentInput.DeckId = null;
        assignmentInput.IsActive = true;
        await LoadClassroomAsync();
    }

    private async Task ToggleAssignmentAsync(Guid assignmentId)
    {
        if (currentTeacher is null)
        {
            return;
        }

        createdCredential = null;
        var assignment = await DbContext.DeckAssignments
            .Include(assignment => assignment.Classroom)
            .SingleOrDefaultAsync(assignment => assignment.Id == assignmentId &&
                assignment.ClassroomId == ClassroomId &&
                assignment.Classroom != null &&
                (assignment.Classroom.CreatedByTeacherId == currentTeacher.Id ||
                    assignment.Classroom.Memberships.Any(membership => membership.UserId == currentTeacher.Id &&
                        membership.Role == ClassroomMemberRole.Teacher &&
                        membership.Status == ClassroomMemberStatus.Approved)));

        if (assignment is null)
        {
            SetStatus("Assignment not found for this classroom.", "notice-danger");
            return;
        }

        assignment.IsActive = !assignment.IsActive;
        await DbContext.SaveChangesAsync();
        Analytics.Capture(currentTeacher.Id, "deck_assignment_toggled", new()
        {
            ["classroom_id"] = ClassroomId,
            ["assignment_id"] = assignment.Id,
            ["deck_id"] = assignment.DeckId,
            ["is_active"] = assignment.IsActive,
        });
        SetStatus(assignment.IsActive ? "Deck activated." : "Deck turned off.");
        await LoadClassroomAsync();
    }

    private async Task LoadClassroomAsync()
    {
        if (currentTeacher is null)
        {
            return;
        }

        classroom = await GetTeacherClassroomQuery()
            .Where(classroom => classroom.Id == ClassroomId)
            .Select(classroom => new ClassroomDetails(
                classroom.Id,
                classroom.Name,
                classroom.JoinCode,
                classroom.Memberships.Count(membership => membership.Role == ClassroomMemberRole.Student && membership.Status == ClassroomMemberStatus.Approved),
                classroom.Assignments.Count(assignment => assignment.IsActive)))
            .SingleOrDefaultAsync();

        if (classroom is null)
        {
            decks = [];
            assignments = [];
            students = [];
            snapshot = new ClassroomSnapshot(0, 0, 0, null);
            attentionItems = [];
            return;
        }

        decks = await DbContext.Decks
            .Where(deck => deck.IsPublished && (deck.IsGlobalStock || deck.OwnerTeacherId == currentTeacher.Id))
            .OrderBy(deck => deck.Title)
            .Select(deck => new DeckOption(deck.Id, deck.Title, deck.Cards.Count))
            .ToListAsync();

        var assignmentSeeds = await DbContext.DeckAssignments
            .Where(assignment => assignment.ClassroomId == ClassroomId)
            .OrderBy(assignment => assignment.Deck!.Title)
            .Select(assignment => new AssignmentSeed(
                assignment.Id,
                assignment.DeckId,
                assignment.Deck!.Title,
                assignment.Deck.Cards.Count,
                assignment.IsActive))
            .ToListAsync();

        var studentSeeds = await DbContext.ClassroomMemberships
            .Where(membership => membership.ClassroomId == ClassroomId &&
                membership.Role == ClassroomMemberRole.Student &&
                membership.Status == ClassroomMemberStatus.Approved)
            .OrderBy(membership => membership.User!.DisplayName)
            .Select(membership => new StudentSeed(
                membership.UserId,
                membership.User!.DisplayName ?? membership.User.UserName ?? "Student",
                membership.User.UserName ?? ""))
            .ToListAsync();

        await LoadProgressSummariesAsync(assignmentSeeds, studentSeeds);
    }

    private async Task LoadProgressSummariesAsync(IReadOnlyList<AssignmentSeed> assignmentSeeds, IReadOnlyList<StudentSeed> studentSeeds)
    {
        var now = DateTimeOffset.UtcNow;
        var recentSince = now.AddDays(-7);
        var inactiveSince = now.AddDays(-5);
        var activeAssignments = assignmentSeeds.Where(assignment => assignment.IsActive).ToList();
        var studentIds = studentSeeds.Select(student => student.UserId).ToHashSet();
        var assignmentIds = assignmentSeeds.Select(assignment => assignment.Id).ToHashSet();
        var deckIds = assignmentSeeds.Select(assignment => assignment.DeckId).ToHashSet();

        if (studentSeeds.Count == 0 || assignmentSeeds.Count == 0)
        {
            assignments = assignmentSeeds
                .Select(assignment => new AssignmentSummary(assignment.Id, assignment.DeckId, assignment.DeckTitle, assignment.CardCount, assignment.IsActive, 0, 0, 0, 0, 0, 0, []))
                .ToList();
            students = studentSeeds
                .Select(student => new StudentSummary(student.UserId, student.DisplayName, student.UserName, 0, 0, 0, 0, 0, 0, 0, 0, null, []))
                .ToList();
            snapshot = new ClassroomSnapshot(0, 0, 0, null);
            attentionItems = [];
            return;
        }

        var cards = await DbContext.Cards
            .Where(card => deckIds.Contains(card.DeckId))
            .OrderBy(card => card.SortOrder)
            .Select(card => new CardSeed(card.Id, card.DeckId, card.Front, card.CardType, card.SortOrder))
            .ToListAsync();
        var cardIds = cards.Select(card => card.Id).ToHashSet();

        var progressEntries = await DbContext.StudentCardProgress
            .Where(progress => studentIds.Contains(progress.UserId) && cardIds.Contains(progress.CardId))
            .Select(progress => new ProgressSeed(
                progress.UserId,
                progress.CardId,
                progress.DueAt,
                progress.ReviewCount,
                progress.LapseCount,
                progress.FsrsState,
                progress.LastReviewedAt))
            .ToListAsync();

        var reviews = await DbContext.ReviewLogs
            .Where(review => review.DeckAssignmentId != null &&
                assignmentIds.Contains(review.DeckAssignmentId.Value) &&
                studentIds.Contains(review.UserId))
            .Select(review => new ReviewSeed(
                review.UserId,
                review.CardId,
                review.DeckAssignmentId!.Value,
                review.ReviewedAt,
                review.WasCorrect))
            .ToListAsync();

        var cardsByDeck = cards
            .GroupBy(card => card.DeckId)
            .ToDictionary(group => group.Key, group => group.ToList());
        var cardById = cards.ToDictionary(card => card.Id);
        var assignmentById = assignmentSeeds.ToDictionary(assignment => assignment.Id);
        var assignmentByDeckId = assignmentSeeds.ToDictionary(assignment => assignment.DeckId);
        var progressByStudentCard = progressEntries
            .GroupBy(progress => (progress.UserId, progress.CardId))
            .ToDictionary(group => group.Key, group => group.First());
        var reviewsByAssignment = reviews
            .GroupBy(review => review.DeckAssignmentId)
            .ToDictionary(group => group.Key, group => group.ToList());
        var reviewsByStudent = reviews
            .GroupBy(review => review.UserId)
            .ToDictionary(group => group.Key, group => group.ToList());

        assignments = assignmentSeeds
            .Select(assignment => BuildAssignmentSummary(
                assignment,
                studentSeeds,
                cardsByDeck.GetValueOrDefault(assignment.DeckId) ?? [],
                progressByStudentCard,
                reviewsByAssignment.GetValueOrDefault(assignment.Id) ?? [],
                cardById,
                now,
                recentSince))
            .ToList();

        students = studentSeeds
            .Select(student => BuildStudentSummary(
                student,
                activeAssignments,
                cardsByDeck,
                progressByStudentCard,
                reviewsByStudent.GetValueOrDefault(student.UserId) ?? [],
                cardById,
                assignmentById,
                assignmentByDeckId,
                now,
                recentSince))
            .ToList();

        var recentReviews = reviews.Where(review => review.ReviewedAt >= recentSince).ToList();
        var studentsNeedingAttention = students.Count(student => NeedsAttention(student, now, inactiveSince));
        snapshot = new ClassroomSnapshot(
            students.Count(student => student.LastReviewedAt is not null && student.LastReviewedAt.Value >= recentSince),
            studentsNeedingAttention,
            students.Sum(student => student.DueCardCount),
            recentReviews.Count == 0 ? null : (int)Math.Round(recentReviews.Count(review => review.WasCorrect) * 100.0 / recentReviews.Count));

        attentionItems = students
            .Where(student => NeedsAttention(student, now, inactiveSince))
            .Select(student => BuildAttentionItem(student, now, inactiveSince))
            .OrderBy(item => item.SortOrder)
            .ThenBy(item => item.StudentName)
            .Take(6)
            .ToList();
    }

    private IQueryable<Classroom> GetTeacherClassroomQuery()
    {
        return DbContext.Classrooms
            .Where(classroom => currentTeacher != null &&
                (classroom.CreatedByTeacherId == currentTeacher.Id ||
                    classroom.Memberships.Any(membership => membership.UserId == currentTeacher.Id &&
                        membership.Role == ClassroomMemberRole.Teacher &&
                        membership.Status == ClassroomMemberStatus.Approved)));
    }

    private static AssignmentSummary BuildAssignmentSummary(
        AssignmentSeed assignment,
        IReadOnlyList<StudentSeed> studentSeeds,
        IReadOnlyList<CardSeed> cards,
        IReadOnlyDictionary<(string UserId, Guid CardId), ProgressSeed> progressByStudentCard,
        IReadOnlyList<ReviewSeed> reviews,
        IReadOnlyDictionary<Guid, CardSeed> cardById,
        DateTimeOffset now,
        DateTimeOffset recentSince)
    {
        var startedStudents = 0;
        var caughtUpStudents = 0;
        var dueCards = 0;
        var notStartedStudents = 0;
        var cardIds = cards.Select(card => card.Id).ToList();

        foreach (var student in studentSeeds)
        {
            var studentProgress = cardIds
                .Select(cardId => progressByStudentCard.GetValueOrDefault((student.UserId, cardId)))
                .Where(progress => progress is not null)
                .ToList();
            var studentReviews = reviews.Where(review => review.UserId == student.UserId).ToList();
            var hasStarted = studentProgress.Count > 0 || studentReviews.Count > 0;
            var studentDueCards = studentProgress.Count(progress => progress!.DueAt <= now);
            var studentNewCards = cards.Count - studentProgress.Count;

            if (hasStarted)
            {
                startedStudents++;
            }
            else
            {
                notStartedStudents++;
            }

            if (hasStarted && studentDueCards == 0 && studentNewCards == 0)
            {
                caughtUpStudents++;
            }

            dueCards += studentDueCards;
        }

        var recentReviews = reviews.Where(review => review.ReviewedAt >= recentSince).ToList();
        var trickyCards = recentReviews
            .GroupBy(review => review.CardId)
            .Select(group => new
            {
                CardId = group.Key,
                AttemptCount = group.Count(),
                MissCount = group.Count(review => !review.WasCorrect),
            })
            .Where(card => card.MissCount > 0 && cardById.ContainsKey(card.CardId))
            .OrderByDescending(card => card.MissCount)
            .ThenByDescending(card => card.AttemptCount)
            .Take(3)
            .Select(card => new TrickyCard(CardPromptText(cardById[card.CardId]), card.MissCount))
            .ToList();

        return new AssignmentSummary(
            assignment.Id,
            assignment.DeckId,
            assignment.DeckTitle,
            assignment.CardCount,
            assignment.IsActive,
            startedStudents,
            caughtUpStudents,
            dueCards,
            notStartedStudents,
            recentReviews.Count,
            recentReviews.Count(review => review.WasCorrect),
            trickyCards);
    }

    private static StudentSummary BuildStudentSummary(
        StudentSeed student,
        IReadOnlyList<AssignmentSeed> activeAssignments,
        IReadOnlyDictionary<Guid, List<CardSeed>> cardsByDeck,
        IReadOnlyDictionary<(string UserId, Guid CardId), ProgressSeed> progressByStudentCard,
        IReadOnlyList<ReviewSeed> reviews,
        IReadOnlyDictionary<Guid, CardSeed> cardById,
        IReadOnlyDictionary<Guid, AssignmentSeed> assignmentById,
        IReadOnlyDictionary<Guid, AssignmentSeed> assignmentByDeckId,
        DateTimeOffset now,
        DateTimeOffset recentSince)
    {
        var dueCards = 0;
        var newCards = 0;
        var learningCards = 0;
        var reviewCards = 0;
        var activeDecksStarted = 0;

        foreach (var assignment in activeAssignments)
        {
            var cards = cardsByDeck.GetValueOrDefault(assignment.DeckId) ?? [];
            var cardIds = cards.Select(card => card.Id).ToList();
            var progressEntries = cardIds
                .Select(cardId => progressByStudentCard.GetValueOrDefault((student.UserId, cardId)))
                .Where(progress => progress is not null)
                .ToList();
            var assignmentReviews = reviews.Where(review => review.DeckAssignmentId == assignment.Id).ToList();

            if (progressEntries.Count > 0 || assignmentReviews.Count > 0)
            {
                activeDecksStarted++;
            }

            dueCards += progressEntries.Count(progress => progress!.DueAt <= now);
            newCards += cards.Count - progressEntries.Count;
            learningCards += progressEntries.Count(progress => !string.Equals(progress!.FsrsState, "Review", StringComparison.OrdinalIgnoreCase));
            reviewCards += progressEntries.Count(progress => string.Equals(progress!.FsrsState, "Review", StringComparison.OrdinalIgnoreCase));
        }

        var recentReviews = reviews.Where(review => review.ReviewedAt >= recentSince).ToList();
        var trickyCards = recentReviews
            .Where(review => !review.WasCorrect && cardById.ContainsKey(review.CardId))
            .GroupBy(review => review.CardId)
            .OrderByDescending(group => group.Count())
            .ThenBy(group => CardPromptText(cardById[group.Key]))
            .Take(3)
            .Select(group =>
            {
                var card = cardById[group.Key];
                var deckTitle = assignmentByDeckId.TryGetValue(card.DeckId, out var assignmentForDeck)
                    ? assignmentForDeck.DeckTitle
                    : assignmentById.GetValueOrDefault(group.First().DeckAssignmentId)?.DeckTitle;
                return new TrickyCard(deckTitle is null ? CardPromptText(card) : $"{CardPromptText(card)} in {deckTitle}", group.Count());
            })
            .ToList();

        return new StudentSummary(
            student.UserId,
            student.DisplayName,
            student.UserName,
            activeAssignments.Count,
            activeDecksStarted,
            dueCards,
            newCards,
            learningCards,
            reviewCards,
            recentReviews.Count,
            recentReviews.Count(review => review.WasCorrect),
            reviews.Select(review => (DateTimeOffset?)review.ReviewedAt).Max(),
            trickyCards);
    }

    private static bool NeedsAttention(StudentSummary student, DateTimeOffset now, DateTimeOffset inactiveSince)
    {
        return student.ActiveDeckCount > 0 &&
            (student.ActiveDecksStarted == 0 ||
                student.DueCardCount >= 10 ||
                student is { RecentAttempts: >= 5, RecentCorrectPercent: < 65 } ||
                (student.DueCardCount > 0 && student.LastReviewedAt is not null && student.LastReviewedAt.Value < inactiveSince) ||
                (student.LastReviewedAt is null && student.NewCardCount > 0));
    }

    private static AttentionItem BuildAttentionItem(StudentSummary student, DateTimeOffset now, DateTimeOffset inactiveSince)
    {
        if (student.ActiveDeckCount > 0 && student.ActiveDecksStarted == 0)
        {
            return new AttentionItem(student.DisplayName, "Not started", "Help this student launch their first active mission.", "warning", 0);
        }

        if (student.DueCardCount >= 10)
        {
            return new AttentionItem(student.DisplayName, "Due pileup", $"Has {student.DueCardCount} cards due now. A short practice block would help.", "warning", 1);
        }

        if (student is { RecentAttempts: >= 5, RecentCorrectPercent: < 65 })
        {
            var trickyText = student.TrickyCards.Count == 0
                ? "recent cards"
                : string.Join(", ", student.TrickyCards.Select(card => card.Prompt));
            return new AttentionItem(student.DisplayName, "Low recent correct", $"Check understanding on {trickyText}.", "warning", 2);
        }

        if (student.LastReviewedAt is null)
        {
            return new AttentionItem(student.DisplayName, "No practice yet", "This student has active work but no practice history yet.", "warning", 3);
        }

        if (student.DueCardCount > 0 && student.LastReviewedAt.Value < inactiveSince)
        {
            return new AttentionItem(student.DisplayName, "Practice gap", $"Last practiced {LastPracticeText(student.LastReviewedAt)} and has due cards waiting.", "warning", 4);
        }

        return new AttentionItem(student.DisplayName, "Check in", "Review this student's active deck progress.", "warning", 5);
    }

    private static string CardPromptText(CardSeed card) => card.CardType == CardType.AudioPrompt
        ? $"Spelling word #{card.SortOrder}"
        : card.Front;

    private static string PercentText(int? percent) => percent is null ? "-" : $"{percent}%";

    private static string AccuracyText(int attempts, int correctCount)
    {
        if (attempts == 0)
        {
            return "No recent attempts";
        }

        return $"{Math.Round(correctCount * 100.0 / attempts):0}% recent correct";
    }

    private static string LastPracticeText(DateTimeOffset? reviewedAt)
    {
        if (reviewedAt is null)
        {
            return "Never";
        }

        var localReviewedAt = reviewedAt.Value.ToLocalTime();
        var localNow = DateTimeOffset.Now;

        if (localReviewedAt.Date == localNow.Date)
        {
            return $"Today at {localReviewedAt:t}";
        }

        if (localReviewedAt.Date == localNow.Date.AddDays(-1))
        {
            return $"Yesterday at {localReviewedAt:t}";
        }

        return localReviewedAt.ToString("MMM d 'at' h:mm tt", CultureInfo.CurrentCulture);
    }

    private async Task<string> GenerateStudentUserNameAsync(string joinCode, string displayName)
    {
        var slug = Slugify($"{joinCode}-{displayName}");
        if (slug.Length > 32)
        {
            slug = slug[..32].Trim('-');
        }

        for (var suffix = 0; suffix < 100; suffix++)
        {
            var candidate = suffix == 0 ? slug : $"{slug}-{suffix}";
            if (await UserManager.FindByNameAsync(candidate) is null)
            {
                return candidate;
            }
        }

        return $"{slug}-{RandomNumberGenerator.GetInt32(1000, 9999)}";
    }

    private string GenerateStudentPassword()
    {
        var word = passwordWords[RandomNumberGenerator.GetInt32(passwordWords.Length)];
        return $"Rocket-{RandomNumberGenerator.GetInt32(10, 99)}-{word}";
    }

    private static string Slugify(string value)
    {
        var builder = new StringBuilder(value.Length);
        var previousWasDash = false;

        foreach (var character in value.ToLowerInvariant())
        {
            if (char.IsLetterOrDigit(character))
            {
                builder.Append(character);
                previousWasDash = false;
            }
            else if (!previousWasDash)
            {
                builder.Append('-');
                previousWasDash = true;
            }
        }

        return builder.ToString().Trim('-');
    }

    private void SetStatus(string message, string cssClass = "notice-success")
    {
        statusMessage = message;
        statusClass = cssClass;
    }

    private void TrackClassroomViewed()
    {
        if (currentTeacher is null || classroom is null)
        {
            return;
        }

        Analytics.Capture(currentTeacher.Id, "classroom_workspace_viewed", new()
        {
            ["classroom_id"] = classroom.Id,
            ["student_count"] = classroom.StudentCount,
            ["active_deck_count"] = classroom.ActiveDeckCount,
            ["assigned_deck_count"] = assignments.Count,
            ["students_needing_attention"] = snapshot.StudentsNeedingAttention,
            ["due_cards_now"] = snapshot.DueCardsNow,
            ["recent_correct_percent"] = snapshot.RecentCorrectPercent,
        });
    }

