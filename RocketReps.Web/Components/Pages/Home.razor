@page "/"

@using Microsoft.Extensions.Options
@using RocketReps.Web.Data
@inject IOptions<DemoOptions> DemoOptions

<PageTitle>Rocket Reps</PageTitle>

<section class="hero-section">
    <div class="hero-copy">
        <p class="eyebrow">Riverview STEM Academy Rockets</p>
        <h1>Build memory like a launch sequence.</h1>
        <p class="hero-lede">
            Rocket Reps helps elementary and middle school students practice a little each day using spaced repetition, starting with math fact missions teachers can assign in minutes.
        </p>
        <div class="hero-actions">
            @if (DemoOptions.Value.Enabled)
            {
                <a class="button-primary" href="demo">Open Demo</a>
            }
            <a class="button-primary" href="Account/Register">Teacher sign up</a>
            <a class="button-secondary" href="Account/Login">Log in</a>
        </div>
    </div>

    <div class="mission-card" aria-label="Mission preview">
        <div class="mission-window">
            <span class="planet planet-one"></span>
            <span class="planet planet-two"></span>
            <span class="rocket">R</span>
        </div>
        <div class="mission-stat-grid">
            <div>
                <strong>4</strong>
                <span>starter decks</span>
            </div>
            <div>
                <strong>0-12</strong>
                <span>math facts</span>
            </div>
            <div>
                <strong>Right / wrong</strong>
                <span>kid-friendly reviews</span>
            </div>
        </div>
    </div>
</section>

<section class="feature-grid" aria-label="Rocket Reps plan">
    <article class="feature-card">
        <span class="feature-number">01</span>
        <h2>Teachers launch classrooms</h2>
        <p>Teachers create classrooms, generate student logins, and activate deck missions when practice time starts.</p>
    </article>
    <article class="feature-card">
        <span class="feature-number">02</span>
        <h2>Students practice short reps</h2>
        <p>The first study flow will use simple right/wrong answers, then map those outcomes into spaced repetition scheduling.</p>
    </article>
    <article class="feature-card">
        <span class="feature-number">03</span>
        <h2>Progress becomes visible</h2>
        <p>After the basic study loop works, teacher dashboards can show due cards, difficult facts, and steady progress.</p>
    </article>
</section>
