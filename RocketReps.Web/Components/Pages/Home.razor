@page "/"

@using Microsoft.Extensions.Options
@using RocketReps.Web.Data
@inject IOptions<DemoOptions> DemoOptions

<PageTitle>Rocket Reps</PageTitle>

<section class="hero-section">
    <div class="hero-copy">
        <p class="eyebrow">Riverview STEM Academy Rockets</p>
        <h1>Build memory like a launch sequence.</h1>
        <p class="hero-lede">
            Rocket Reps helps elementary and middle school students build stronger recall with short, teacher-assigned practice missions for math facts, spelling, and classroom knowledge.
        </p>
        <div class="hero-actions">
            @if (DemoOptions.Value.Enabled)
            {
                <a class="button-primary" href="demo">Open Demo</a>
            }
            <a class="button-primary" href="Account/Register">Teacher sign up</a>
            <a class="button-secondary" href="Account/Login">Log in</a>
        </div>
    </div>

    <div class="mission-card" aria-label="Mission preview">
        <div class="mission-window">
            <span class="planet planet-one"></span>
            <span class="planet planet-two"></span>
            <span class="rocket">R</span>
        </div>
        <div class="mission-stat-grid">
            <div>
                <strong>Ready-made</strong>
                <span>classroom decks</span>
            </div>
            <div>
                <strong>0-12</strong>
                <span>math facts</span>
            </div>
            <div>
                <strong>Quick reps</strong>
                <span>kid-friendly reviews</span>
            </div>
        </div>
    </div>
</section>

<section class="feature-grid" aria-label="Rocket Reps features">
    <article class="feature-card">
        <span class="feature-number">01</span>
        <h2>Teachers launch classrooms</h2>
        <p>Teachers create classrooms, generate student logins, and turn ready-made decks on or off when practice time starts.</p>
    </article>
    <article class="feature-card">
        <span class="feature-number">02</span>
        <h2>Students practice short reps</h2>
        <p>Students answer quick right/wrong, typed, audio, or multiple-choice cards while Rocket Reps schedules the next review.</p>
    </article>
    <article class="feature-card">
        <span class="feature-number">03</span>
        <h2>Progress becomes visible</h2>
        <p>Students can see due cards, new cards, attempts, correct totals, streaks, and what is coming next.</p>
    </article>
</section>
