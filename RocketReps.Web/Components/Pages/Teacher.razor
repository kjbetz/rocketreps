@page "/teacher"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Teacher")]
@using System.ComponentModel.DataAnnotations
@using System.Security.Cryptography
@using System.Text
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RocketReps.Web.Data
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Teacher Dashboard</PageTitle>

<section class="page-hero compact">
    <p class="eyebrow">Teacher launchpad</p>
    <h1>Build your classroom mission.</h1>
    <p>Create classrooms, generate student logins, and activate ready-made decks when your class is ready to practice.</p>
</section>

@if (isLoading)
{
    <div class="loading-card">Loading teacher dashboard...</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="notice @statusClass">@statusMessage</div>
    }

    @if (createdCredential is not null)
    {
        <section class="content-card credential-card" aria-live="polite">
            <p class="eyebrow">Student login created</p>
            <h2>@createdCredential.DisplayName</h2>
            <div class="credential-grid">
                <div>
                    <span>Username</span>
                    <strong>@createdCredential.UserName</strong>
                </div>
                <div>
                    <span>Password</span>
                    <strong>@createdCredential.Password</strong>
                </div>
            </div>
            <p class="status-muted">Passwords are shown once. Reset the student password later if this one is lost.</p>
        </section>
    }

    <div class="layout-grid dashboard-grid">
        <section class="layout-panel">
            <div class="content-card">
                <h2>Create a classroom</h2>
                <EditForm Model="classroomInput" OnValidSubmit="CreateClassroomAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="status-danger" />
                    <div class="field-stack">
                        <InputText @bind-Value="classroomInput.Name" id="ClassroomName" class="field-input" placeholder="Period 2 Math Rockets" />
                        <label for="ClassroomName">Classroom name</label>
                    </div>
                    <button type="submit" class="button-primary button-full">Create classroom</button>
                </EditForm>
            </div>
        </section>

        <section class="layout-panel">
            <div class="content-card">
                <h2>Create a student login</h2>
                <EditForm Model="studentInput" OnValidSubmit="CreateStudentAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="status-danger" />
                    <div class="field-stack">
                        <InputSelect @bind-Value="studentInput.ClassroomId" id="StudentClassroom" class="field-input">
                            <option value="">Choose a classroom</option>
                            @foreach (var classroom in classrooms)
                            {
                                <option value="@classroom.Id">@classroom.Name</option>
                            }
                        </InputSelect>
                        <label for="StudentClassroom">Classroom</label>
                    </div>
                    <div class="field-stack">
                        <InputText @bind-Value="studentInput.DisplayName" id="StudentDisplayName" class="field-input" placeholder="Aria M." />
                        <label for="StudentDisplayName">Student display name</label>
                    </div>
                    <button type="submit" class="button-primary button-full" disabled="@(classrooms.Count == 0)">Generate login</button>
                </EditForm>
            </div>
        </section>

        <section class="layout-panel layout-panel-wide">
            <div class="content-card">
                <h2>Assign a ready-made deck</h2>
                <EditForm Model="assignmentInput" OnValidSubmit="AssignDeckAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="status-danger" />
                    <div class="assignment-form-grid">
                        <div class="field-stack">
                            <InputSelect @bind-Value="assignmentInput.ClassroomId" id="AssignmentClassroom" class="field-input">
                                <option value="">Choose a classroom</option>
                                @foreach (var classroom in classrooms)
                                {
                                    <option value="@classroom.Id">@classroom.Name</option>
                                }
                            </InputSelect>
                            <label for="AssignmentClassroom">Classroom</label>
                        </div>
                        <div class="field-stack">
                            <InputSelect @bind-Value="assignmentInput.DeckId" id="AssignmentDeck" class="field-input">
                                <option value="">Choose a deck</option>
                                @foreach (var deck in decks)
                                {
                                    <option value="@deck.Id">@deck.Title (@deck.CardCount cards)</option>
                                }
                            </InputSelect>
                            <label for="AssignmentDeck">Deck</label>
                        </div>
                        <label class="field-label assignment-active-toggle">
                            <InputCheckbox @bind-Value="assignmentInput.IsActive" class="field-checkbox" />
                            Active now
                        </label>
                    </div>
                    <button type="submit" class="button-primary" disabled="@(classrooms.Count == 0 || decks.Count == 0)">Assign deck</button>
                </EditForm>
            </div>
        </section>
    </div>

    <section class="dashboard-section">
        <h2>Your classrooms</h2>
        @if (classrooms.Count == 0)
        {
            <div class="content-card">Create your first classroom to start adding students and deck missions.</div>
        }
        else
        {
            <div class="management-grid">
                @foreach (var classroom in classrooms)
                {
                    <article class="management-card">
                        <div class="management-card-header">
                            <h3>@classroom.Name</h3>
                            <span>@classroom.JoinCode</span>
                        </div>
                        <p>@classroom.StudentCount students · @classroom.ActiveDeckCount active decks</p>
                    </article>
                }
            </div>
        }
    </section>

    <section class="dashboard-section">
        <h2>Deck assignments</h2>
        @if (assignments.Count == 0)
        {
            <div class="content-card">No decks assigned yet. Assign a ready-made deck above, then turn it active when students should work on it.</div>
        }
        else
        {
            <div class="management-grid">
                @foreach (var assignment in assignments)
                {
                    <article class="management-card">
                        <div class="management-card-header">
                            <h3>@assignment.DeckTitle</h3>
                            <span class="@(assignment.IsActive ? "status-pill active" : "status-pill")">@(assignment.IsActive ? "Active" : "Inactive")</span>
                        </div>
                        <p>@assignment.ClassroomName · @assignment.CardCount cards</p>
                        <button type="button" class="button-secondary" @onclick="() => ToggleAssignmentAsync(assignment.Id)">
                            @(assignment.IsActive ? "Turn off" : "Activate")
                        </button>
                    </article>
                }
            </div>
        }
    </section>

    <section class="dashboard-section">
        <h2>Students</h2>
        @if (students.Count == 0)
        {
            <div class="content-card">Student accounts you create will appear here with their usernames.</div>
        }
        else
        {
            <div class="table-wrap content-card">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Username</th>
                            <th>Classroom</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in students)
                        {
                            <tr>
                                <td>@student.DisplayName</td>
                                <td>@student.UserName</td>
                                <td>@student.ClassroomName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    private readonly ClassroomInput classroomInput = new();
    private readonly StudentInput studentInput = new();
    private readonly AssignmentInput assignmentInput = new() { IsActive = true };
    private readonly string[] passwordWords = ["comet", "orbit", "lunar", "solar", "nova", "rocket", "star"];
    private ApplicationUser? currentTeacher;
    private bool isLoading = true;
    private string? statusMessage;
    private string statusClass = "notice-success";
    private CreatedCredential? createdCredential;
    private List<ClassroomSummary> classrooms = [];
    private List<DeckOption> decks = [];
    private List<AssignmentSummary> assignments = [];
    private List<StudentSummary> students = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentTeacher = await UserManager.GetUserAsync(authState.User);
        await LoadDashboardAsync();
        isLoading = false;
    }

    private async Task CreateClassroomAsync()
    {
        if (currentTeacher is null)
        {
            return;
        }

        createdCredential = null;
        var schoolId = await EnsureTeacherSchoolAsync();
        var classroom = new Classroom
        {
            Id = Guid.NewGuid(),
            SchoolId = schoolId,
            CreatedByTeacherId = currentTeacher.Id,
            Name = classroomInput.Name.Trim(),
            JoinCode = await GenerateJoinCodeAsync(),
            RequiresTeacherApproval = true,
        };

        classroom.Memberships.Add(new ClassroomMembership
        {
            Id = Guid.NewGuid(),
            UserId = currentTeacher.Id,
            Role = ClassroomMemberRole.Teacher,
            Status = ClassroomMemberStatus.Approved,
            ApprovedAt = DateTimeOffset.UtcNow,
            ApprovedByTeacherId = currentTeacher.Id,
        });

        DbContext.Classrooms.Add(classroom);
        await DbContext.SaveChangesAsync();
        classroomInput.Name = string.Empty;
        SetStatus($"Created {classroom.Name}.");
        await LoadDashboardAsync();
    }

    private async Task CreateStudentAsync()
    {
        if (currentTeacher is null || studentInput.ClassroomId is null)
        {
            return;
        }

        createdCredential = null;
        var classroom = await GetTeacherClassroomQuery()
            .SingleOrDefaultAsync(classroom => classroom.Id == studentInput.ClassroomId.Value);

        if (classroom is null)
        {
            SetStatus("Choose one of your classrooms before creating a student.", "notice-danger");
            return;
        }

        var displayName = studentInput.DisplayName.Trim();
        var userName = await GenerateStudentUserNameAsync(classroom.JoinCode, displayName);
        var password = GenerateStudentPassword();
        var student = new ApplicationUser
        {
            UserName = userName,
            DisplayName = displayName,
            EmailConfirmed = true,
            SchoolId = classroom.SchoolId,
        };

        var result = await UserManager.CreateAsync(student, password);
        if (!result.Succeeded)
        {
            SetStatus(string.Join(" ", result.Errors.Select(error => error.Description)), "notice-danger");
            return;
        }

        result = await UserManager.AddToRoleAsync(student, "Student");
        if (!result.Succeeded)
        {
            SetStatus(string.Join(" ", result.Errors.Select(error => error.Description)), "notice-danger");
            return;
        }

        DbContext.ClassroomMemberships.Add(new ClassroomMembership
        {
            Id = Guid.NewGuid(),
            ClassroomId = classroom.Id,
            UserId = student.Id,
            Role = ClassroomMemberRole.Student,
            Status = ClassroomMemberStatus.Approved,
            ApprovedAt = DateTimeOffset.UtcNow,
            ApprovedByTeacherId = currentTeacher.Id,
        });

        await DbContext.SaveChangesAsync();
        studentInput.DisplayName = string.Empty;
        createdCredential = new CreatedCredential(displayName, userName, password);
        SetStatus($"Created login for {displayName}.");
        await LoadDashboardAsync();
    }

    private async Task AssignDeckAsync()
    {
        if (currentTeacher is null || assignmentInput.ClassroomId is null || assignmentInput.DeckId is null)
        {
            return;
        }

        createdCredential = null;
        var classroom = await GetTeacherClassroomQuery()
            .SingleOrDefaultAsync(classroom => classroom.Id == assignmentInput.ClassroomId.Value);

        if (classroom is null)
        {
            SetStatus("Choose one of your classrooms before assigning a deck.", "notice-danger");
            return;
        }

        var deckExists = await DbContext.Decks.AnyAsync(deck => deck.Id == assignmentInput.DeckId.Value && deck.IsPublished);
        if (!deckExists)
        {
            SetStatus("Choose a published deck before assigning it.", "notice-danger");
            return;
        }

        var assignment = await DbContext.DeckAssignments
            .FirstOrDefaultAsync(existingAssignment => existingAssignment.ClassroomId == classroom.Id && existingAssignment.DeckId == assignmentInput.DeckId.Value);

        if (assignment is null)
        {
            assignment = new DeckAssignment
            {
                Id = Guid.NewGuid(),
                ClassroomId = classroom.Id,
                DeckId = assignmentInput.DeckId.Value,
                AssignedByTeacherId = currentTeacher.Id,
                IsActive = assignmentInput.IsActive,
                IsOpenStudyAllowed = true,
            };

            DbContext.DeckAssignments.Add(assignment);
        }
        else
        {
            assignment.IsActive = assignmentInput.IsActive;
        }

        await DbContext.SaveChangesAsync();
        SetStatus(assignmentInput.IsActive ? "Deck assigned and activated." : "Deck assigned as inactive.");
        await LoadDashboardAsync();
    }

    private async Task ToggleAssignmentAsync(Guid assignmentId)
    {
        if (currentTeacher is null)
        {
            return;
        }

        createdCredential = null;
        var assignment = await DbContext.DeckAssignments
            .Include(assignment => assignment.Classroom)
            .SingleOrDefaultAsync(assignment => assignment.Id == assignmentId &&
                assignment.Classroom != null &&
                (assignment.Classroom.CreatedByTeacherId == currentTeacher.Id ||
                    assignment.Classroom.Memberships.Any(membership => membership.UserId == currentTeacher.Id &&
                        membership.Role == ClassroomMemberRole.Teacher &&
                        membership.Status == ClassroomMemberStatus.Approved)));

        if (assignment is null)
        {
            SetStatus("Assignment not found for your classroom.", "notice-danger");
            return;
        }

        assignment.IsActive = !assignment.IsActive;
        await DbContext.SaveChangesAsync();
        SetStatus(assignment.IsActive ? "Deck activated." : "Deck turned off.");
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        if (currentTeacher is null)
        {
            return;
        }

        classrooms = await GetTeacherClassroomQuery()
            .OrderBy(classroom => classroom.Name)
            .Select(classroom => new ClassroomSummary(
                classroom.Id,
                classroom.Name,
                classroom.JoinCode,
                classroom.Memberships.Count(membership => membership.Role == ClassroomMemberRole.Student && membership.Status == ClassroomMemberStatus.Approved),
                classroom.Assignments.Count(assignment => assignment.IsActive)))
            .ToListAsync();

        decks = await DbContext.Decks
            .Where(deck => deck.IsPublished && (deck.IsGlobalStock || deck.OwnerTeacherId == currentTeacher.Id))
            .OrderBy(deck => deck.Title)
            .Select(deck => new DeckOption(deck.Id, deck.Title, deck.Cards.Count))
            .ToListAsync();

        assignments = await DbContext.DeckAssignments
            .Where(assignment => assignment.Classroom != null &&
                (assignment.Classroom.CreatedByTeacherId == currentTeacher.Id ||
                    assignment.Classroom.Memberships.Any(membership => membership.UserId == currentTeacher.Id &&
                        membership.Role == ClassroomMemberRole.Teacher &&
                        membership.Status == ClassroomMemberStatus.Approved)))
            .OrderBy(assignment => assignment.Classroom!.Name)
            .ThenBy(assignment => assignment.Deck!.Title)
            .Select(assignment => new AssignmentSummary(
                assignment.Id,
                assignment.ClassroomId,
                assignment.Classroom!.Name,
                assignment.Deck!.Title,
                assignment.Deck.Cards.Count,
                assignment.IsActive))
            .ToListAsync();

        students = await DbContext.ClassroomMemberships
            .Where(membership => membership.Role == ClassroomMemberRole.Student &&
                membership.Status == ClassroomMemberStatus.Approved &&
                membership.Classroom != null &&
                (membership.Classroom.CreatedByTeacherId == currentTeacher.Id ||
                    membership.Classroom.Memberships.Any(teacherMembership => teacherMembership.UserId == currentTeacher.Id &&
                        teacherMembership.Role == ClassroomMemberRole.Teacher &&
                        teacherMembership.Status == ClassroomMemberStatus.Approved)))
            .OrderBy(membership => membership.Classroom!.Name)
            .ThenBy(membership => membership.User!.DisplayName)
            .Select(membership => new StudentSummary(
                membership.User!.DisplayName ?? membership.User.UserName ?? "Student",
                membership.User.UserName ?? "",
                membership.Classroom!.Name))
            .ToListAsync();
    }

    private IQueryable<Classroom> GetTeacherClassroomQuery()
    {
        return DbContext.Classrooms
            .Where(classroom => currentTeacher != null &&
                (classroom.CreatedByTeacherId == currentTeacher.Id ||
                    classroom.Memberships.Any(membership => membership.UserId == currentTeacher.Id &&
                        membership.Role == ClassroomMemberRole.Teacher &&
                        membership.Status == ClassroomMemberStatus.Approved)));
    }

    private async Task<Guid> EnsureTeacherSchoolAsync()
    {
        if (currentTeacher?.SchoolId is { } schoolId)
        {
            return schoolId;
        }

        var school = await DbContext.Schools.OrderBy(existingSchool => existingSchool.Name).FirstOrDefaultAsync();
        if (school is null)
        {
            school = new School
            {
                Id = Guid.NewGuid(),
                Name = "Rocket Reps Workspace",
                Mascot = "Rockets",
            };
            DbContext.Schools.Add(school);
            await DbContext.SaveChangesAsync();
        }

        currentTeacher!.SchoolId = school.Id;
        await UserManager.UpdateAsync(currentTeacher);
        return school.Id;
    }

    private async Task<string> GenerateJoinCodeAsync()
    {
        const string alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
        while (true)
        {
            var builder = new StringBuilder(6);
            for (var index = 0; index < 6; index++)
            {
                builder.Append(alphabet[RandomNumberGenerator.GetInt32(alphabet.Length)]);
            }

            var code = builder.ToString();
            if (!await DbContext.Classrooms.AnyAsync(classroom => classroom.JoinCode == code))
            {
                return code;
            }
        }
    }

    private async Task<string> GenerateStudentUserNameAsync(string joinCode, string displayName)
    {
        var slug = Slugify($"{joinCode}-{displayName}");
        if (slug.Length > 32)
        {
            slug = slug[..32].Trim('-');
        }

        for (var suffix = 0; suffix < 100; suffix++)
        {
            var candidate = suffix == 0 ? slug : $"{slug}-{suffix}";
            if (await UserManager.FindByNameAsync(candidate) is null)
            {
                return candidate;
            }
        }

        return $"{slug}-{RandomNumberGenerator.GetInt32(1000, 9999)}";
    }

    private string GenerateStudentPassword()
    {
        var word = passwordWords[RandomNumberGenerator.GetInt32(passwordWords.Length)];
        return $"Rocket-{RandomNumberGenerator.GetInt32(10, 99)}-{word}";
    }

    private static string Slugify(string value)
    {
        var builder = new StringBuilder(value.Length);
        var previousWasDash = false;

        foreach (var character in value.ToLowerInvariant())
        {
            if (char.IsLetterOrDigit(character))
            {
                builder.Append(character);
                previousWasDash = false;
            }
            else if (!previousWasDash)
            {
                builder.Append('-');
                previousWasDash = true;
            }
        }

        return builder.ToString().Trim('-');
    }

    private void SetStatus(string message, string cssClass = "notice-success")
    {
        statusMessage = message;
        statusClass = cssClass;
    }

    private sealed class ClassroomInput
    {
        [Required]
        [StringLength(160, MinimumLength = 2)]
        public string Name { get; set; } = string.Empty;
    }

    private sealed class StudentInput
    {
        [Required]
        public Guid? ClassroomId { get; set; }

        [Required]
        [StringLength(160, MinimumLength = 2)]
        public string DisplayName { get; set; } = string.Empty;
    }

    private sealed class AssignmentInput
    {
        [Required]
        public Guid? ClassroomId { get; set; }

        [Required]
        public Guid? DeckId { get; set; }

        public bool IsActive { get; set; }
    }

    private sealed record ClassroomSummary(Guid Id, string Name, string JoinCode, int StudentCount, int ActiveDeckCount);
    private sealed record DeckOption(Guid Id, string Title, int CardCount);
    private sealed record AssignmentSummary(Guid Id, Guid ClassroomId, string ClassroomName, string DeckTitle, int CardCount, bool IsActive);
    private sealed record StudentSummary(string DisplayName, string UserName, string ClassroomName);
    private sealed record CreatedCredential(string DisplayName, string UserName, string Password);
}
