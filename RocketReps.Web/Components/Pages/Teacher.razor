@page "/teacher"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Teacher")]
@using System.ComponentModel.DataAnnotations
@using System.Security.Cryptography
@using System.Text
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using RocketReps.Web.Data
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IRocketRepsAnalytics Analytics

<PageTitle>Teacher Dashboard</PageTitle>

<section class="page-hero compact">
    <p class="eyebrow">Teacher launchpad</p>
    <h1>Choose a classroom mission.</h1>
    <p>Start with the classroom you want to manage, then add students, assign decks, and control what is active from that classroom workspace.</p>
</section>

@if (isLoading)
{
    <div class="loading-card">Loading teacher dashboard...</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="notice @statusClass">@statusMessage</div>
    }

    <div class="layout-grid dashboard-grid">
        <section class="layout-panel">
            <div class="content-card">
                <h2>Create a classroom</h2>
                <p class="status-muted">Create a workspace for a class, group, or intervention block.</p>
                <EditForm Model="classroomInput" OnValidSubmit="CreateClassroomAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="status-danger" />
                    <div class="field-stack">
                        <InputText @bind-Value="classroomInput.Name" id="ClassroomName" class="field-input" placeholder="Period 2 Math Rockets" />
                        <label for="ClassroomName">Classroom name</label>
                    </div>
                    <button type="submit" class="button-primary button-full">Create classroom</button>
                </EditForm>
            </div>
        </section>

        <section class="layout-panel">
            <div class="content-card deck-library-card">
                <p class="eyebrow">Deck library</p>
                <h2>Manage reusable decks.</h2>
                <p>Browse ready-made decks and keep custom deck work separate from classroom activation.</p>
                <div class="classroom-stat-row">
                    <span>@deckLibrary.StockDeckCount ready-made</span>
                    <span>@deckLibrary.TeacherDeckCount custom</span>
                </div>
                <div class="card-actions">
                    <a class="button-primary" href="teacher/decks">Manage decks</a>
                </div>
            </div>
        </section>
    </div>

    <section class="dashboard-section">
        <div class="dashboard-section-header">
            <div>
                <p class="eyebrow">Classrooms</p>
                <h2>Your classroom workspaces</h2>
            </div>
        </div>
        @if (classrooms.Count == 0)
        {
            <div class="content-card">Create your first classroom to start adding students and deck missions.</div>
        }
        else
        {
            <div class="management-grid classroom-grid">
                @foreach (var classroom in classrooms)
                {
                    <article class="management-card classroom-card">
                        <div class="management-card-header">
                            <h3>@classroom.Name</h3>
                            <span>@classroom.JoinCode</span>
                        </div>
                        <div class="classroom-stat-row">
                            <span>@classroom.StudentCount students</span>
                            <span>@classroom.ActiveDeckCount active decks</span>
                            <span>@classroom.TotalDeckCount assigned</span>
                        </div>
                        <a class="button-primary button-full" href="@($"teacher/classrooms/{classroom.Id}")">Open classroom</a>
                    </article>
                }
            </div>
        }
    </section>
}

@code {
    private readonly ClassroomInput classroomInput = new();
    private ApplicationUser? currentTeacher;
    private bool isLoading = true;
    private string? statusMessage;
    private string statusClass = "notice-success";
    private List<ClassroomSummary> classrooms = [];
    private DeckLibrarySummary deckLibrary = new(0, 0);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentTeacher = await UserManager.GetUserAsync(authState.User);
        await LoadDashboardAsync();
        isLoading = false;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            TrackDashboardViewed();
        }
    }

    private async Task CreateClassroomAsync()
    {
        if (currentTeacher is null)
        {
            return;
        }

        var schoolId = await EnsureTeacherSchoolAsync();
        var classroom = new Classroom
        {
            Id = Guid.NewGuid(),
            SchoolId = schoolId,
            CreatedByTeacherId = currentTeacher.Id,
            Name = classroomInput.Name.Trim(),
            JoinCode = await GenerateJoinCodeAsync(),
            RequiresTeacherApproval = true,
        };

        classroom.Memberships.Add(new ClassroomMembership
        {
            Id = Guid.NewGuid(),
            UserId = currentTeacher.Id,
            Role = ClassroomMemberRole.Teacher,
            Status = ClassroomMemberStatus.Approved,
            ApprovedAt = DateTimeOffset.UtcNow,
            ApprovedByTeacherId = currentTeacher.Id,
        });

        DbContext.Classrooms.Add(classroom);
        await DbContext.SaveChangesAsync();
        Analytics.Capture(currentTeacher.Id, "classroom_created", new()
        {
            ["classroom_id"] = classroom.Id,
            ["school_id"] = schoolId,
        });
        classroomInput.Name = string.Empty;
        SetStatus($"Created {classroom.Name}. Open it to add students and decks.");
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        if (currentTeacher is null)
        {
            return;
        }

        classrooms = await GetTeacherClassroomQuery()
            .OrderBy(classroom => classroom.Name)
            .Select(classroom => new ClassroomSummary(
                classroom.Id,
                classroom.Name,
                classroom.JoinCode,
                classroom.Memberships.Count(membership => membership.Role == ClassroomMemberRole.Student && membership.Status == ClassroomMemberStatus.Approved),
                classroom.Assignments.Count(assignment => assignment.IsActive),
                classroom.Assignments.Count))
            .ToListAsync();

        var stockDeckCount = await DbContext.Decks
            .CountAsync(deck => deck.IsPublished && deck.IsGlobalStock);
        var teacherDeckCount = await DbContext.Decks
            .CountAsync(deck => deck.IsPublished && deck.OwnerTeacherId == currentTeacher.Id);
        deckLibrary = new DeckLibrarySummary(stockDeckCount, teacherDeckCount);
    }

    private IQueryable<Classroom> GetTeacherClassroomQuery()
    {
        return DbContext.Classrooms
            .Where(classroom => currentTeacher != null &&
                (classroom.CreatedByTeacherId == currentTeacher.Id ||
                    classroom.Memberships.Any(membership => membership.UserId == currentTeacher.Id &&
                        membership.Role == ClassroomMemberRole.Teacher &&
                        membership.Status == ClassroomMemberStatus.Approved)));
    }

    private async Task<Guid> EnsureTeacherSchoolAsync()
    {
        if (currentTeacher?.SchoolId is { } schoolId)
        {
            return schoolId;
        }

        var school = await DbContext.Schools.OrderBy(existingSchool => existingSchool.Name).FirstOrDefaultAsync();
        if (school is null)
        {
            school = new School
            {
                Id = Guid.NewGuid(),
                Name = "Rocket Reps Workspace",
                Mascot = "Rockets",
            };
            DbContext.Schools.Add(school);
            await DbContext.SaveChangesAsync();
        }

        currentTeacher!.SchoolId = school.Id;
        await UserManager.UpdateAsync(currentTeacher);
        return school.Id;
    }

    private async Task<string> GenerateJoinCodeAsync()
    {
        const string alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
        while (true)
        {
            var builder = new StringBuilder(6);
            for (var index = 0; index < 6; index++)
            {
                builder.Append(alphabet[RandomNumberGenerator.GetInt32(alphabet.Length)]);
            }

            var code = builder.ToString();
            if (!await DbContext.Classrooms.AnyAsync(classroom => classroom.JoinCode == code))
            {
                return code;
            }
        }
    }

    private void SetStatus(string message, string cssClass = "notice-success")
    {
        statusMessage = message;
        statusClass = cssClass;
    }

    private void TrackDashboardViewed()
    {
        if (currentTeacher is null)
        {
            return;
        }

        Analytics.Capture(currentTeacher.Id, "teacher_dashboard_viewed", new()
        {
            ["classroom_count"] = classrooms.Count,
            ["student_count"] = classrooms.Sum(classroom => classroom.StudentCount),
            ["active_deck_count"] = classrooms.Sum(classroom => classroom.ActiveDeckCount),
            ["assigned_deck_count"] = classrooms.Sum(classroom => classroom.TotalDeckCount),
            ["stock_deck_count"] = deckLibrary.StockDeckCount,
            ["published_teacher_deck_count"] = deckLibrary.TeacherDeckCount,
        });
    }

    private sealed class ClassroomInput
    {
        [Required]
        [StringLength(160, MinimumLength = 2)]
        public string Name { get; set; } = string.Empty;
    }

    private sealed record ClassroomSummary(Guid Id, string Name, string JoinCode, int StudentCount, int ActiveDeckCount, int TotalDeckCount);
    private sealed record DeckLibrarySummary(int StockDeckCount, int TeacherDeckCount);
}
