@page "/Account/Register"

@inject NavigationManager NavigationManager

<PageTitle>Early Access - Rocket Reps</PageTitle>

<section class="page-hero compact">
    <p class="eyebrow">Teacher accounts</p>
    <h1>Rocket Reps is in early access.</h1>
    <p>Public account creation is paused for the Open House. Request early access and we will follow up after the event.</p>
    <div class="hero-actions">
        <a class="button-primary" href="early-access">Request early access</a>
        <a class="button-secondary" href="demo">Launch Demo</a>
    </div>
</section>

@code {
    protected override void OnInitialized()
    {
        NavigationManager.NavigateTo("early-access", replace: true);
    }
}
